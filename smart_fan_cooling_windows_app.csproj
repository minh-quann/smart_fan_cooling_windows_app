<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net9.0-windows10.0.22621.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <RootNamespace>SmartFanCooling</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Platforms>x64;ARM64</Platforms>
    <Platform>x64</Platform>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <UseWinUI>true</UseWinUI>
    <UseXamlCompilerExecutable>false</UseXamlCompilerExecutable>
    <WindowsPackageType>None</WindowsPackageType>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <EnableMsixTooling>true</EnableMsixTooling>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <ApplicationIcon>app_icon.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="1.6.241114003" />
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" Version="10.0.26100.1742" />
    <PackageReference Include="LibreHardwareMonitorLib" Version="0.9.3" />
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.3.2" />
    <PackageReference Include="System.IO.Ports" Version="9.0.0" />
    <PackageReference Include="System.Management" Version="9.0.0" />
    <PackageReference Include="System.Drawing.Common" Version="9.0.0" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="app_icon.ico">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <!-- Tell dotnet watch to monitor all XAML files for instant auto-reload -->
  <ItemGroup>
    <Watch Include="**\*.xaml" Exclude="obj\**\*;bin\**\*" />
  </ItemGroup>

  <!-- Centralized Version Management -->
  <!-- Pass version via: dotnet build -t:Installer -p:AppVersion=1.0.1 -->
  <PropertyGroup>
    <AppVersion Condition="'$(AppVersion)' == ''">1.0.0</AppVersion>
    <Version>$(AppVersion)</Version>
    <AssemblyVersion>$(AppVersion).0</AssemblyVersion>
    <FileVersion>$(AppVersion).0</FileVersion>
    <InformationalVersion>$(AppVersion)</InformationalVersion>
  </PropertyGroup>

  <!-- Custom MSBuild Target for Inno Setup Installer Generation -->
  <!-- Command: .\installer 1.0.1  OR  dotnet build -t:Installer -p:AppVersion=1.0.1 -->
  <Target Name="Installer">
    <Message Text="=================================================================" Importance="high" />
    <Message Text=" SMART FAN COOLING HUB - INSTALLER BUILD v$(AppVersion)          " Importance="high" />
    <Message Text="=================================================================" Importance="high" />
    <Message Text=" [1/2] PUBLISHING RELEASE BINARIES (win-x64)...                  " Importance="high" />
    <Message Text="=================================================================" Importance="high" />
    
    <MSBuild Projects="$(MSBuildProjectFullPath)"
             Targets="Publish"
             Properties="Configuration=Release;Platform=x64;RuntimeIdentifier=win-x64;SelfContained=true;WindowsAppSDKSelfContained=true;AppVersion=$(AppVersion)" />

    <Message Text="=================================================================" Importance="high" />
    <Message Text=" [2/2] COMPILING INNO SETUP EXE INSTALLER v$(AppVersion)...      " Importance="high" />
    <Message Text="=================================================================" Importance="high" />

    <Exec Command="&quot;C:\Program Files\Inno Setup 7\ISCC.exe&quot; /DMyAppVersion=&quot;$(AppVersion)&quot; &quot;$(MSBuildProjectDirectory)\build\installer.iss&quot;"
          Condition="Exists('C:\Program Files\Inno Setup 7\ISCC.exe')" />
          
    <Exec Command="&quot;C:\Program Files (x86)\Inno Setup 6\ISCC.exe&quot; /DMyAppVersion=&quot;$(AppVersion)&quot; &quot;$(MSBuildProjectDirectory)\build\installer.iss&quot;"
          Condition="!Exists('C:\Program Files\Inno Setup 7\ISCC.exe') And Exists('C:\Program Files (x86)\Inno Setup 6\ISCC.exe')" />

    <Exec Command="&quot;C:\Program Files\Inno Setup 6\ISCC.exe&quot; /DMyAppVersion=&quot;$(AppVersion)&quot; &quot;$(MSBuildProjectDirectory)\build\installer.iss&quot;"
          Condition="!Exists('C:\Program Files\Inno Setup 7\ISCC.exe') And !Exists('C:\Program Files (x86)\Inno Setup 6\ISCC.exe') And Exists('C:\Program Files\Inno Setup 6\ISCC.exe')" />

    <Exec Command="&quot;$(LocalAppData)\Programs\Inno Setup 6\ISCC.exe&quot; /DMyAppVersion=&quot;$(AppVersion)&quot; &quot;$(MSBuildProjectDirectory)\build\installer.iss&quot;"
          Condition="!Exists('C:\Program Files\Inno Setup 7\ISCC.exe') And !Exists('C:\Program Files (x86)\Inno Setup 6\ISCC.exe') And !Exists('C:\Program Files\Inno Setup 6\ISCC.exe') And Exists('$(LocalAppData)\Programs\Inno Setup 6\ISCC.exe')" />

    <Message Text="=================================================================" Importance="high" />
    <Message Text=" SUCCESS! v$(AppVersion) Installer => OutputInstaller\            " Importance="high" />
    <Message Text="=================================================================" Importance="high" />
  </Target>
</Project>
