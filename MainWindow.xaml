<Window
    x:Class="SmartFanCooling.MainWindow"
    x:Name="RootWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid>
        <NavigationView x:Name="MainNav"
                        PaneDisplayMode="Left"
                        IsBackButtonVisible="Collapsed"
                        IsSettingsVisible="True"
                        SelectionChanged="MainNav_SelectionChanged">

            <!-- Sidebar Left Menu Items -->
            <NavigationView.MenuItems>
                <NavigationViewItem Content="Tổng Quan Hệ Thống" Tag="0">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE80F;"/>
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="Profile &amp; Fan Curve" Tag="1">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE9D9;"/>
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="Đèn LED RGB" Tag="2">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE790;"/>
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="Gán App Auto-Switch" Tag="3">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE71D;"/>
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="Thông Số Phần Cứng" Tag="4">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE9E9;"/>
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="Tùy Biến 2 Màn OLED" Tag="5">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE7B8;"/>
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="HUD Overlay Game/App" Tag="6">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE7F4;"/>
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
            </NavigationView.MenuItems>

            <!-- Top Header & Main Content Body -->
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                
                <!-- Top Header Connection Bar -->
                <Border Grid.Row="0" Padding="16,10" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="0,0,0,1">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="10">
                            <FontIcon Glyph="&#xE9CA;" FontSize="22" Foreground="{ThemeResource SystemAccentColor}"/>
                            <StackPanel>
                                <TextBlock Text="SMART FAN COOLING HUB" FontSize="15" FontWeight="Bold"/>
                                <TextBlock Text="UNIVERSAL SYSTEM CONTROL HUB" FontSize="10" Foreground="{ThemeResource SystemAccentColor}" FontWeight="Bold"/>
                            </StackPanel>
                        </StackPanel>

                        <!-- Connection Control Panel (Multi-Protocol: USB Serial, Bluetooth BLE, Wi-Fi IP) -->
                        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                            <TextBlock Text="Giao thức:" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                            
                            <ComboBox SelectedValue="{Binding SelectedConnectionProtocol, Mode=TwoWay}" SelectedValuePath="Tag" Width="150">
                                <ComboBoxItem Tag="USB">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <FontIcon Glyph="&#xE814;" Foreground="#4CAF50" FontSize="13"/>
                                        <TextBlock Text="Cáp USB Serial"/>
                                    </StackPanel>
                                </ComboBoxItem>
                                <ComboBoxItem Tag="BLE">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <FontIcon Glyph="&#xE702;" Foreground="#00BCD4" FontSize="13"/>
                                        <TextBlock Text="Bluetooth BLE"/>
                                    </StackPanel>
                                </ComboBoxItem>
                                <ComboBoxItem Tag="WIFI">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <FontIcon Glyph="&#xE701;" Foreground="#FF9800" FontSize="13"/>
                                        <TextBlock Text="Mạng Wi-Fi"/>
                                    </StackPanel>
                                </ComboBoxItem>
                            </ComboBox>

                            <!-- USB COM Port Options -->
                            <StackPanel Orientation="Horizontal" Spacing="6" Visibility="{Binding SelectedConnectionProtocol, Converter={StaticResource StringMatchToVisibilityConverter}, ConverterParameter=USB}">
                                <ComboBox ItemsSource="{Binding AvailableComPorts}" SelectedItem="{Binding SelectedComPort, Mode=TwoWay}" Width="100"/>
                                <Button Command="{Binding RefreshComPortsCommand}" ToolTipService.ToolTip="Tìm cổng COM">
                                    <FontIcon Glyph="&#xE72C;" FontSize="12"/>
                                </Button>
                            </StackPanel>

                            <!-- Bluetooth BLE Options -->
                            <StackPanel Orientation="Horizontal" Spacing="6" Visibility="{Binding SelectedConnectionProtocol, Converter={StaticResource StringMatchToVisibilityConverter}, ConverterParameter=BLE}">
                                <Button Command="{Binding OpenEspConnectionDialogCommand}" CommandParameter="0" Style="{ThemeResource AccentButtonStyle}" Padding="10,5">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <FontIcon Glyph="&#xE702;" FontSize="12"/>
                                        <TextBlock Text="Quét &amp; Kết Nối BLE" FontWeight="Bold"/>
                                    </StackPanel>
                                </Button>
                            </StackPanel>

                            <!-- Wi-Fi IP Options -->
                            <StackPanel Orientation="Horizontal" Spacing="6" Visibility="{Binding SelectedConnectionProtocol, Converter={StaticResource StringMatchToVisibilityConverter}, ConverterParameter=WIFI}">
                                <Button Command="{Binding OpenEspConnectionDialogCommand}" CommandParameter="1" Style="{ThemeResource AccentButtonStyle}" Padding="10,5">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <FontIcon Glyph="&#xE701;" FontSize="12"/>
                                        <TextBlock Text="Cấu Hình Wi-Fi / IP" FontWeight="Bold"/>
                                    </StackPanel>
                                </Button>
                            </StackPanel>

                            <Button Content="{Binding IsConnected, Converter={StaticResource ConnectTextConverter}}" 
                                    Command="{Binding ToggleConnectionCommand}"
                                    Style="{ThemeResource AccentButtonStyle}"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Dynamic Tab Views Container -->
                <ScrollViewer Grid.Row="1" Padding="20">
                    <Grid>

                        <!-- TAB 0: TỔNG QUAN HỆ THỐNG (OVERVIEW - MATCHING DASHBOARD_SCREEN.DART 1:1) -->
                        <StackPanel Spacing="18" Visibility="{Binding SelectedTabIndex, Converter={StaticResource IntToVisibilityConverter}, ConverterParameter=0}">
                            
                            <!-- Profile Selector Row Header -->
                            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" CornerRadius="10" Padding="14">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                                        <FontIcon Glyph="&#xE9CA;" Foreground="{ThemeResource SystemAccentColor}" FontSize="18"/>
                                        <TextBlock Text="PROFILE HỆ THỐNG:" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                        <TextBlock Text="{Binding ActiveProfile.Name}" FontWeight="Bold" Foreground="{ThemeResource SystemAccentColor}" FontSize="16" VerticalAlignment="Center"/>
                                    </StackPanel>

                                    <!-- Dynamic Profile List & Add/Delete Controls -->
                                    <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8">
                                        <ItemsControl ItemsSource="{Binding Profiles}">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <StackPanel Orientation="Horizontal" Spacing="6"/>
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Button Click="ProfileBtn_Click" Tag="{Binding}" Padding="10,6">
                                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                                            <FontIcon Glyph="{Binding IconGlyph}" Foreground="{Binding ColorHex}" FontSize="13"/>
                                                            <TextBlock Text="{Binding Name}" FontWeight="Bold"/>
                                                        </StackPanel>
                                                    </Button>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>

                                        <Button Command="{Binding AddNewProfileCommand}" ToolTipService.ToolTip="Thêm Profile Mới" Padding="10,6" Style="{ThemeResource AccentButtonStyle}">
                                            <StackPanel Orientation="Horizontal" Spacing="6">
                                                <FontIcon Glyph="&#xE710;" FontSize="12"/>
                                                <TextBlock Text="Thêm Profile" FontWeight="Bold"/>
                                            </StackPanel>
                                        </Button>

                                        <Button Command="{Binding DeleteActiveProfileCommand}" ToolTipService.ToolTip="Xóa Profile Đang Chọn" Padding="8,6">
                                            <FontIcon Glyph="&#xE74D;" Foreground="#F44336" FontSize="13"/>
                                        </Button>
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <!-- Responsive 2-Column Dashboard Grid -->
                            <Grid ColumnSpacing="18">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="5*"/>
                                    <ColumnDefinition Width="7*"/>
                                </Grid.ColumnDefinitions>
                                
                                <!-- LEFT COLUMN: RPM Gauge Widget & Quick Fan Control Widget -->
                                <StackPanel Grid.Column="0" Spacing="16">
                                    
                                    <!-- RPM Radial Gauge Card Widget -->
                                    <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" CornerRadius="12" Padding="20">
                                        <StackPanel Spacing="16" HorizontalAlignment="Center">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <StackPanel Orientation="Horizontal" Spacing="8">
                                                    <FontIcon Glyph="&#xE9CA;" Foreground="{ThemeResource SystemAccentColor}" FontSize="18"/>
                                                    <TextBlock Text="LLANO SMART FAN HUB" FontWeight="Bold" FontSize="14"/>
                                                </StackPanel>
                                                <Border Grid.Column="1" Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}" CornerRadius="6" Padding="8,3">
                                                    <TextBlock Text="{Binding ConnectionStatusText}" FontSize="11" FontWeight="Bold" Foreground="{ThemeResource SystemAccentColor}"/>
                                                </Border>
                                            </Grid>

                                            <!-- Circular RPM Display Box -->
                                            <Border Width="190" Height="190" CornerRadius="95" Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}" BorderBrush="{ThemeResource SystemAccentColor}" BorderThickness="3" HorizontalAlignment="Center">
                                                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="4">
                                                    <FontIcon Glyph="&#xE9CA;" Foreground="{ThemeResource SystemAccentColor}" FontSize="28"/>
                                                    <TextBlock Text="{Binding FanRpm}" FontSize="38" FontWeight="Bold" HorizontalAlignment="Center" Foreground="{ThemeResource SystemAccentColor}"/>
                                                    <TextBlock Text="RPM" FontSize="12" FontWeight="Bold" Foreground="{ThemeResource TextFillColorSecondaryBrush}" HorizontalAlignment="Center"/>
                                                    <TextBlock Text="{Binding FanPwm, Converter={StaticResource FloatFormatConverter}, ConverterParameter='{}PWM: {0}%'}" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" HorizontalAlignment="Center" Margin="0,4,0,0"/>
                                                </StackPanel>
                                            </Border>
                                        </StackPanel>
                                    </Border>

                                    <!-- Quick Fan Control Card Widget -->
                                    <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" CornerRadius="12" Padding="20">
                                        <StackPanel Spacing="14">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="ĐIỀU CHỈNH TỐC ĐỘ QUẠT" FontWeight="Bold" FontSize="14"/>
                                                <ToggleSwitch Grid.Column="1" Header="Tự Động Fan Curve" IsOn="{Binding IsAutoMode, Mode=TwoWay}"/>
                                            </Grid>

                                            <!-- Auto Fan Curve Graph Panel (Visible when Tự Động Fan Curve is ON) -->
                                            <StackPanel Visibility="{Binding IsAutoMode, Converter={StaticResource BoolToVisibilityConverter}}" Spacing="10" Margin="0,4,0,0">
                                                <Border Background="#101217" BorderBrush="#252936" BorderThickness="1" CornerRadius="10" Padding="12">
                                                    <StackPanel Spacing="8">
                                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                                            <FontIcon Glyph="&#xE9D2;" Foreground="{ThemeResource SystemAccentColor}" FontSize="13"/>
                                                            <TextBlock Text="ĐƯỜNG CONG TẠO TỰ ĐỘNG (KÉO TRỰC TIẾP ĐỂ ĐIỀU CHỈNH)" FontWeight="Bold" FontSize="11"/>
                                                        </StackPanel>

                                                        <Grid Margin="24,0,12,0">
                                                            <Canvas x:Name="OverviewFanCurveCanvas" Height="170" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Background="Transparent"
                                                                    SizeChanged="OverviewFanCurveCanvas_SizeChanged"
                                                                    PointerPressed="OverviewFanCurveCanvas_PointerPressed"
                                                                    PointerMoved="OverviewFanCurveCanvas_PointerMoved"
                                                                    PointerReleased="OverviewFanCurveCanvas_PointerReleased"
                                                                    PointerCanceled="OverviewFanCurveCanvas_PointerReleased">
                                                                <!-- Grid Horizontal Lines -->
                                                                <Line x:Name="O_GridH_100" X1="0" Y1="10" X2="400" Y2="10" Stroke="#1E222F" StrokeDashArray="3 3" StrokeThickness="1"/>
                                                                <Line x:Name="O_GridH_75"  X1="0" Y1="45" X2="400" Y2="45" Stroke="#1E222F" StrokeDashArray="3 3" StrokeThickness="1"/>
                                                                <Line x:Name="O_GridH_50"  X1="0" Y1="80" X2="400" Y2="80" Stroke="#1E222F" StrokeDashArray="3 3" StrokeThickness="1"/>
                                                                <Line x:Name="O_GridH_25"  X1="0" Y1="115" X2="400" Y2="115" Stroke="#1E222F" StrokeDashArray="3 3" StrokeThickness="1"/>
                                                                <Line x:Name="O_GridH_0"   X1="0" Y1="150" X2="400" Y2="150" Stroke="#1E222F" StrokeThickness="1"/>

                                                                <!-- Y-Axis Labels -->
                                                                <TextBlock Text="100%" Canvas.Left="-28" Canvas.Top="4" FontSize="9" Foreground="#8A92A6"/>
                                                                <TextBlock Text="75%"  Canvas.Left="-24" Canvas.Top="39" FontSize="9" Foreground="#8A92A6"/>
                                                                <TextBlock Text="50%"  Canvas.Left="-24" Canvas.Top="74" FontSize="9" Foreground="#8A92A6"/>
                                                                <TextBlock Text="25%"  Canvas.Left="-24" Canvas.Top="109" FontSize="9" Foreground="#8A92A6"/>
                                                                <TextBlock Text="0%"   Canvas.Left="-18" Canvas.Top="144" FontSize="9" Foreground="#8A92A6"/>

                                                                <!-- Grid Vertical Lines -->
                                                                <Line x:Name="O_GridV_30" Y1="10" Y2="150" Stroke="#1E222F" StrokeDashArray="3 3" StrokeThickness="1"/>
                                                                <Line x:Name="O_GridV_40" Y1="10" Y2="150" Stroke="#1E222F" StrokeDashArray="3 3" StrokeThickness="1"/>
                                                                <Line x:Name="O_GridV_50" Y1="10" Y2="150" Stroke="#1E222F" StrokeDashArray="3 3" StrokeThickness="1"/>
                                                                <Line x:Name="O_GridV_60" Y1="10" Y2="150" Stroke="#1E222F" StrokeDashArray="3 3" StrokeThickness="1"/>
                                                                <Line x:Name="O_GridV_70" Y1="10" Y2="150" Stroke="#1E222F" StrokeDashArray="3 3" StrokeThickness="1"/>
                                                                <Line x:Name="O_GridV_80" Y1="10" Y2="150" Stroke="#1E222F" StrokeDashArray="3 3" StrokeThickness="1"/>
                                                                <Line x:Name="O_GridV_90" Y1="10" Y2="150" Stroke="#1E222F" StrokeDashArray="3 3" StrokeThickness="1"/>

                                                                <!-- Polygon Area Fill Under Curve -->
                                                                <Polygon x:Name="O_CurvePolygonFill" Fill="{ThemeResource SystemAccentColor}" Opacity="0.15"/>

                                                                <!-- Pure White Polyline Curve -->
                                                                <Polyline x:Name="O_CurvePolyline" Stroke="White" StrokeThickness="2" StrokeLineJoin="Round"/>

                                                                <!-- 7 Solid White Square Handles -->
                                                                <Rectangle x:Name="O_NodeRect_30" Width="8" Height="8" Fill="White" Stroke="#101217" StrokeThickness="1" Canvas.Left="0" Canvas.Top="0"/>
                                                                <Rectangle x:Name="O_NodeRect_40" Width="8" Height="8" Fill="White" Stroke="#101217" StrokeThickness="1" Canvas.Left="0" Canvas.Top="0"/>
                                                                <Rectangle x:Name="O_NodeRect_50" Width="8" Height="8" Fill="White" Stroke="#101217" StrokeThickness="1" Canvas.Left="0" Canvas.Top="0"/>
                                                                <Rectangle x:Name="O_NodeRect_60" Width="8" Height="8" Fill="White" Stroke="#101217" StrokeThickness="1" Canvas.Left="0" Canvas.Top="0"/>
                                                                <Rectangle x:Name="O_NodeRect_70" Width="8" Height="8" Fill="White" Stroke="#101217" StrokeThickness="1" Canvas.Left="0" Canvas.Top="0"/>
                                                                <Rectangle x:Name="O_NodeRect_80" Width="8" Height="8" Fill="White" Stroke="#101217" StrokeThickness="1" Canvas.Left="0" Canvas.Top="0"/>
                                                                <Rectangle x:Name="O_NodeRect_90" Width="8" Height="8" Fill="White" Stroke="#101217" StrokeThickness="1" Canvas.Left="0" Canvas.Top="0"/>

                                                                <!-- X-Axis Temperature Labels -->
                                                                <TextBlock x:Name="O_TxtLabel_30" Text="30°C" Canvas.Top="155" FontSize="9" Foreground="#8A92A6"/>
                                                                <TextBlock x:Name="O_TxtLabel_40" Text="40°C" Canvas.Top="155" FontSize="9" Foreground="#8A92A6"/>
                                                                <TextBlock x:Name="O_TxtLabel_50" Text="50°C" Canvas.Top="155" FontSize="9" Foreground="#8A92A6"/>
                                                                <TextBlock x:Name="O_TxtLabel_60" Text="60°C" Canvas.Top="155" FontSize="9" Foreground="#8A92A6"/>
                                                                <TextBlock x:Name="O_TxtLabel_70" Text="70°C" Canvas.Top="155" FontSize="9" Foreground="#8A92A6"/>
                                                                <TextBlock x:Name="O_TxtLabel_80" Text="80°C" Canvas.Top="155" FontSize="9" Foreground="#8A92A6"/>
                                                                <TextBlock x:Name="O_TxtLabel_90" Text="90°C" Canvas.Top="155" FontSize="9" Foreground="#8A92A6"/>
                                                            </Canvas>
                                                        </Grid>
                                                    </StackPanel>
                                                </Border>
                                            </StackPanel>

                                            <!-- Preset Speed Buttons (Dynamic & Customizable) -->
                                            <Grid Margin="0,0,0,4">
                                                <TextBlock Text="Mức Tốc Độ Nhanh (Nhấp chọn - Chuột phải để Xóa):" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center"/>
                                                <Button HorizontalAlignment="Right" Command="{Binding ResetDefaultRpmPresetsCommand}" ToolTipService.ToolTip="Khôi phục các mốc mặc định (Tắt, 800, 1200, 1600, 2000, 2800)">
                                                    <StackPanel Orientation="Horizontal" Spacing="4">
                                                        <FontIcon Glyph="&#xE72C;" FontSize="10"/>
                                                        <TextBlock Text="Mặc định" FontSize="11"/>
                                                    </StackPanel>
                                                </Button>
                                            </Grid>

                                            <!-- ItemsControl for Dynamic Preset Buttons -->
                                            <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled" Margin="0,2,0,4">
                                                <ItemsControl ItemsSource="{Binding QuickRpmPresets}">
                                                    <ItemsControl.ItemsPanel>
                                                        <ItemsPanelTemplate>
                                                            <StackPanel Orientation="Horizontal" Spacing="6"/>
                                                        </ItemsPanelTemplate>
                                                    </ItemsControl.ItemsPanel>
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <Button Content="{Binding Label}"
                                                                    Click="OnPresetButtonClick"
                                                                    Tag="{Binding}"
                                                                    Padding="12,6" CornerRadius="6">
                                                                <Button.ContextFlyout>
                                                                    <MenuFlyout>
                                                                        <MenuFlyoutItem Text="Xóa mốc này" Click="OnDeletePresetClick" Tag="{Binding}">
                                                                            <MenuFlyoutItem.Icon>
                                                                                <FontIcon Glyph="&#xE74D;"/>
                                                                            </MenuFlyoutItem.Icon>
                                                                        </MenuFlyoutItem>
                                                                    </MenuFlyout>
                                                                </Button.ContextFlyout>
                                                            </Button>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </ScrollViewer>

                                            <!-- Add New Custom Preset Bar -->
                                            <Expander Header="➕ Thêm mốc tốc độ mới" ExpandDirection="Down" HorizontalAlignment="Stretch" Margin="0,2,0,4">
                                                <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,4,0,0">
                                                    <NumberBox PlaceholderText="Nhập RPM (VD: 500)" Value="{Binding NewPresetRpm, Mode=TwoWay}" SmallChange="100" LargeChange="100" Minimum="0" Maximum="2800" Width="180"/>
                                                    <Button Content="Thêm Mốc" Command="{Binding AddCustomRpmPresetCommand}" Style="{StaticResource AccentButtonStyle}"/>
                                                </StackPanel>
                                            </Expander>

                                            <!-- Target RPM Slider -->
                                            <TextBlock Text="Tốc Độ Quạt Mục Tiêu (RPM):" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Margin="0,6,0,0"/>
                                            <Slider Minimum="0" Maximum="2800" StepFrequency="100" Value="{Binding TargetRpm, Mode=TwoWay}" IsEnabled="{Binding IsAutoMode, Converter={StaticResource InverseBoolConverter}}"/>
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="Đặt Trước Tốc Độ:" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                                <TextBlock Grid.Column="2" Text="{Binding TargetRpm, Converter={StaticResource FloatFormatConverter}, ConverterParameter='{}{0} RPM'}" FontWeight="Bold" FontSize="16" Foreground="{ThemeResource SystemAccentColor}"/>
                                            </Grid>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>

                                <!-- RIGHT COLUMN: Hardware Cards for CPU, GPU, RAM -->
                                <StackPanel Grid.Column="1" Spacing="16">
                                    
                                    <!-- CPU Telemetry Card -->
                                    <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" CornerRadius="12" Padding="20">
                                        <StackPanel Spacing="12">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <StackPanel Orientation="Horizontal" Spacing="10">
                                                    <FontIcon Glyph="&#xE9E9;" Foreground="#FF5722" FontSize="20"/>
                                                    <StackPanel>
                                                        <TextBlock Text="Nhiệt Độ Vi Xử Lý CPU" FontWeight="Bold" FontSize="14"/>
                                                        <TextBlock Text="{Binding CpuName}" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                                    </StackPanel>
                                                </StackPanel>
                                                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding CpuTemp, Converter={StaticResource FloatFormatConverter}, ConverterParameter='{}{0:F0}'}" FontSize="28" FontWeight="Bold" Foreground="#FF5722"/>
                                                    <TextBlock Text="°C" FontSize="16" FontWeight="Bold" Foreground="#FF5722" VerticalAlignment="Top" Margin="0,4,0,0"/>
                                                </StackPanel>
                                            </Grid>

                                            <!-- CPU Usage Load Progress Bar -->
                                            <ProgressBar Value="{Binding CpuUsage}" Maximum="100" Height="8" Foreground="#FF5722"/>

                                            <!-- CPU Metric Pills -->
                                            <StackPanel Orientation="Horizontal" Spacing="6">
                                                <Border Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}" CornerRadius="6" Padding="8,4" Margin="0,0,6,6">
                                                    <TextBlock Text="{Binding CpuUsage, Converter={StaticResource FloatFormatConverter}, ConverterParameter='{}Mức sử dụng: {0:F0}%'}" FontSize="11" Foreground="#FF5722" FontWeight="SemiBold"/>
                                                </Border>
                                                <Border Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}" CornerRadius="6" Padding="8,4" Margin="0,0,6,6">
                                                    <TextBlock Text="{Binding CpuMaxClockGHz, Converter={StaticResource FloatFormatConverter}, ConverterParameter='{}Tốc độ Clock: {0:F2} GHz'}" FontSize="11" Foreground="#00BCD4" FontWeight="SemiBold"/>
                                                </Border>
                                                <Border Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}" CornerRadius="6" Padding="8,4" Margin="0,0,6,6">
                                                    <TextBlock Text="{Binding CpuFanRpm, Converter={StaticResource FloatFormatConverter}, ConverterParameter='{}Quạt CPU Laptop: {0} RPM'}" FontSize="11" Foreground="#4CAF50" FontWeight="SemiBold"/>
                                                </Border>
                                                <Border Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}" CornerRadius="6" Padding="8,4" Margin="0,0,6,6">
                                                    <TextBlock Text="{Binding CpuPowerW, Converter={StaticResource FloatFormatConverter}, ConverterParameter='{}Công suất: {0:F1} W'}" FontSize="11" Foreground="#FF9800" FontWeight="SemiBold"/>
                                                </Border>
                                            </StackPanel>
                                        </StackPanel>
                                    </Border>

                                    <!-- GPU Telemetry Card -->
                                    <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" CornerRadius="12" Padding="20">
                                        <StackPanel Spacing="12">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <StackPanel Orientation="Horizontal" Spacing="10">
                                                    <FontIcon Glyph="&#xE7F8;" Foreground="#FF9800" FontSize="20"/>
                                                    <StackPanel>
                                                        <TextBlock Text="Nhiệt Độ Card Đồ Họa GPU" FontWeight="Bold" FontSize="14"/>
                                                        <TextBlock Text="{Binding GpuName}" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                                    </StackPanel>
                                                </StackPanel>
                                                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding GpuTemp, Converter={StaticResource FloatFormatConverter}, ConverterParameter='{}{0:F0}'}" FontSize="28" FontWeight="Bold" Foreground="#FF9800"/>
                                                    <TextBlock Text="°C" FontSize="16" FontWeight="Bold" Foreground="#FF9800" VerticalAlignment="Top" Margin="0,4,0,0"/>
                                                </StackPanel>
                                            </Grid>

                                            <!-- GPU Usage Load Progress Bar -->
                                            <ProgressBar Value="{Binding GpuUsage}" Maximum="100" Height="8" Foreground="#FF9800"/>

                                            <!-- GPU Metric Pills -->
                                            <StackPanel Orientation="Horizontal" Spacing="6">
                                                <Border Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}" CornerRadius="6" Padding="8,4" Margin="0,0,6,6">
                                                    <TextBlock Text="{Binding GpuUsage, Converter={StaticResource FloatFormatConverter}, ConverterParameter='{}Mức sử dụng GPU: {0:F0}%'}" FontSize="11" Foreground="#FF9800" FontWeight="SemiBold"/>
                                                </Border>
                                                <Border Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}" CornerRadius="6" Padding="8,4" Margin="0,0,6,6">
                                                    <TextBlock Text="{Binding GpuClockMHz, Converter={StaticResource FloatFormatConverter}, ConverterParameter='{}Xung nhịp: {0:F0} MHz'}" FontSize="11" Foreground="#00BCD4" FontWeight="SemiBold"/>
                                                </Border>
                                                <Border Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}" CornerRadius="6" Padding="8,4" Margin="0,0,6,6">
                                                    <TextBlock Text="{Binding GpuFanRpm, Converter={StaticResource FloatFormatConverter}, ConverterParameter='{}Quạt GPU Laptop: {0} RPM'}" FontSize="11" Foreground="#4CAF50" FontWeight="SemiBold"/>
                                                </Border>
                                                <Border Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}" CornerRadius="6" Padding="8,4" Margin="0,0,6,6">
                                                    <TextBlock Text="{Binding GpuPowerW, Converter={StaticResource FloatFormatConverter}, ConverterParameter='{}Công suất GPU: {0:F1} W'}" FontSize="11" Foreground="#FF5722" FontWeight="SemiBold"/>
                                                </Border>
                                                <Border Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}" CornerRadius="6" Padding="8,4" Margin="0,0,6,6">
                                                    <TextBlock Text="{Binding GpuVramUsedGB, Converter={StaticResource FloatFormatConverter}, ConverterParameter='{}VRAM Used: {0:F1} GB'}" FontSize="11" Foreground="#9C27B0" FontWeight="SemiBold"/>
                                                </Border>
                                            </StackPanel>
                                        </StackPanel>
                                    </Border>

                                    <!-- RAM Telemetry Card -->
                                    <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" CornerRadius="12" Padding="20">
                                        <StackPanel Spacing="12">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <StackPanel Orientation="Horizontal" Spacing="10">
                                                    <FontIcon Glyph="&#xE7FA;" Foreground="#9C27B0" FontSize="20"/>
                                                    <StackPanel>
                                                        <TextBlock Text="Mức Sử Dụng RAM Hệ Thống" FontWeight="Bold" FontSize="14"/>
                                                        <TextBlock Text="DDR4/DDR5 High Performance System RAM" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                                    </StackPanel>
                                                </StackPanel>
                                                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding RamUsagePercent, Converter={StaticResource FloatFormatConverter}, ConverterParameter='{}{0:F0}'}" FontSize="28" FontWeight="Bold" Foreground="#9C27B0"/>
                                                    <TextBlock Text="%" FontSize="16" FontWeight="Bold" Foreground="#9C27B0" VerticalAlignment="Top" Margin="0,4,0,0"/>
                                                </StackPanel>
                                            </Grid>

                                            <!-- RAM Usage Progress Bar -->
                                            <ProgressBar Value="{Binding RamUsagePercent}" Maximum="100" Height="8" Foreground="#9C27B0"/>

                                            <StackPanel Orientation="Horizontal" Spacing="6">
                                                <Border Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}" CornerRadius="6" Padding="8,4" Margin="0,0,6,6">
                                                    <TextBlock Text="{Binding RamStatusText}" FontSize="11" Foreground="#9C27B0" FontWeight="SemiBold"/>
                                                </Border>
                                                <Border Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}" CornerRadius="6" Padding="8,4" Margin="0,0,6,6">
                                                    <TextBlock Text="Trạng thái: Optimal Performance" FontSize="11" Foreground="#4CAF50" FontWeight="SemiBold"/>
                                                </Border>
                                            </StackPanel>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                        <StackPanel Spacing="18" Visibility="{Binding SelectedTabIndex, Converter={StaticResource IntToVisibilityConverter}, ConverterParameter=1}">
                            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" CornerRadius="10" Padding="16">
                                <StackPanel Spacing="14">
                                    <TextBlock Text="Thiết Lập Đường Cong Nhiệt Độ (Fan Curve Editor)" FontSize="16" FontWeight="Bold"/>
                                    <TextBlock Text="Tùy chỉnh phần trăm PWM của quạt ứng với các mốc nhiệt độ CPU/GPU (°C)." Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                    
                                     <!-- 2D FAN CURVE CHART DISPLAY (ARMOURY CRATE & MSI AFTERBURNER STYLE) -->
                                     <Border Background="#101217" BorderBrush="#252936" BorderThickness="1" CornerRadius="10" Padding="16,14" Margin="0,4,0,10">
                                         <Grid>
                                             <Grid.RowDefinitions>
                                                 <RowDefinition Height="Auto"/>
                                                 <RowDefinition Height="210"/>
                                                 <RowDefinition Height="Auto"/>
                                             </Grid.RowDefinitions>
                                             
                                             <!-- Header -->
                                             <StackPanel Grid.Row="0" Orientation="Horizontal" HorizontalAlignment="Stretch" Margin="0,0,0,10">
                                                 <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                                     <FontIcon Glyph="&#xE9D2;" Foreground="{ThemeResource SystemAccentColor}" FontSize="14"/>
                                                     <TextBlock Text="BIỂU ĐỒ ĐƯỜNG CONG TỐC ĐỘ QUẠT (KÉO TRỰC TIẾP TRÊN NÚT NỐI)" FontWeight="Bold" FontSize="13"/>
                                                 </StackPanel>
                                             </StackPanel>

                                             <!-- 2D Canvas Chart Box -->
                                             <Grid Grid.Row="1" Margin="34,0,16,0">
                                                 <Canvas x:Name="FanCurveCanvas" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Background="Transparent"
                                                         SizeChanged="FanCurveCanvas_SizeChanged"
                                                         PointerPressed="FanCurveCanvas_PointerPressed"
                                                         PointerMoved="FanCurveCanvas_PointerMoved"
                                                         PointerReleased="FanCurveCanvas_PointerReleased"
                                                         PointerCanceled="FanCurveCanvas_PointerReleased">
                                                     <!-- Grid Horizontal Lines -->
                                                     <Line x:Name="GridH_100" X1="0" Y1="15" X2="600" Y2="15" Stroke="#1E222F" StrokeDashArray="3 3" StrokeThickness="1"/>
                                                     <Line x:Name="GridH_75"  X1="0" Y1="57" X2="600" Y2="57" Stroke="#1E222F" StrokeDashArray="3 3" StrokeThickness="1"/>
                                                     <Line x:Name="GridH_50"  X1="0" Y1="100" X2="600" Y2="100" Stroke="#1E222F" StrokeDashArray="3 3" StrokeThickness="1"/>
                                                     <Line x:Name="GridH_25"  X1="0" Y1="142" X2="600" Y2="142" Stroke="#1E222F" StrokeDashArray="3 3" StrokeThickness="1"/>
                                                     <Line x:Name="GridH_0"   X1="0" Y1="185" X2="600" Y2="185" Stroke="#1E222F" StrokeThickness="1"/>

                                                     <!-- Y-Axis Labels -->
                                                     <TextBlock Text="100%" Canvas.Left="-34" Canvas.Top="7" FontSize="10" Foreground="#8A92A6"/>
                                                     <TextBlock Text="75%"  Canvas.Left="-28" Canvas.Top="49" FontSize="10" Foreground="#8A92A6"/>
                                                     <TextBlock Text="50%"  Canvas.Left="-28" Canvas.Top="92" FontSize="10" Foreground="#8A92A6"/>
                                                     <TextBlock Text="25%"  Canvas.Left="-28" Canvas.Top="134" FontSize="10" Foreground="#8A92A6"/>
                                                     <TextBlock Text="0%"   Canvas.Left="-22" Canvas.Top="177" FontSize="10" Foreground="#8A92A6"/>

                                                     <!-- Grid Vertical Lines -->
                                                     <Line x:Name="GridV_30" Y1="15" Y2="185" Stroke="#1E222F" StrokeDashArray="3 3" StrokeThickness="1"/>
                                                     <Line x:Name="GridV_40" Y1="15" Y2="185" Stroke="#1E222F" StrokeDashArray="3 3" StrokeThickness="1"/>
                                                     <Line x:Name="GridV_50" Y1="15" Y2="185" Stroke="#1E222F" StrokeDashArray="3 3" StrokeThickness="1"/>
                                                     <Line x:Name="GridV_60" Y1="15" Y2="185" Stroke="#1E222F" StrokeDashArray="3 3" StrokeThickness="1"/>
                                                     <Line x:Name="GridV_70" Y1="15" Y2="185" Stroke="#1E222F" StrokeDashArray="3 3" StrokeThickness="1"/>
                                                     <Line x:Name="GridV_80" Y1="15" Y2="185" Stroke="#1E222F" StrokeDashArray="3 3" StrokeThickness="1"/>
                                                     <Line x:Name="GridV_90" Y1="15" Y2="185" Stroke="#1E222F" StrokeDashArray="3 3" StrokeThickness="1"/>

                                                     <!-- Area Fill Under Curve -->
                                                     <Polygon x:Name="CurvePolygonFill" Fill="{ThemeResource SystemAccentColor}" Opacity="0.15"/>

                                                     <!-- Pure White Polyline Curve (Armoury Crate Style) -->
                                                     <Polyline x:Name="CurvePolyline" Stroke="White" StrokeThickness="2.5" StrokeLineJoin="Round"/>

                                                     <!-- 7 Solid White Square Handles (Armoury Crate Nodes) -->
                                                     <Rectangle x:Name="NodeRect_30" Width="10" Height="10" Fill="White" Stroke="#101217" StrokeThickness="1" Canvas.Left="0" Canvas.Top="0"/>
                                                     <Rectangle x:Name="NodeRect_40" Width="10" Height="10" Fill="White" Stroke="#101217" StrokeThickness="1" Canvas.Left="0" Canvas.Top="0"/>
                                                     <Rectangle x:Name="NodeRect_50" Width="10" Height="10" Fill="White" Stroke="#101217" StrokeThickness="1" Canvas.Left="0" Canvas.Top="0"/>
                                                     <Rectangle x:Name="NodeRect_60" Width="10" Height="10" Fill="White" Stroke="#101217" StrokeThickness="1" Canvas.Left="0" Canvas.Top="0"/>
                                                     <Rectangle x:Name="NodeRect_70" Width="10" Height="10" Fill="White" Stroke="#101217" StrokeThickness="1" Canvas.Left="0" Canvas.Top="0"/>
                                                     <Rectangle x:Name="NodeRect_80" Width="10" Height="10" Fill="White" Stroke="#101217" StrokeThickness="1" Canvas.Left="0" Canvas.Top="0"/>
                                                     <Rectangle x:Name="NodeRect_90" Width="10" Height="10" Fill="White" Stroke="#101217" StrokeThickness="1" Canvas.Left="0" Canvas.Top="0"/>

                                                     <!-- X-Axis Temperature Labels (100% Perfectly Aligned to Vertical Grid Lines) -->
                                                     <TextBlock x:Name="TxtLabel_30" Text="30°C" Canvas.Top="192" FontSize="11" Foreground="#8A92A6"/>
                                                     <TextBlock x:Name="TxtLabel_40" Text="40°C" Canvas.Top="192" FontSize="11" Foreground="#8A92A6"/>
                                                     <TextBlock x:Name="TxtLabel_50" Text="50°C" Canvas.Top="192" FontSize="11" Foreground="#8A92A6"/>
                                                     <TextBlock x:Name="TxtLabel_60" Text="60°C" Canvas.Top="192" FontSize="11" Foreground="#8A92A6"/>
                                                     <TextBlock x:Name="TxtLabel_70" Text="70°C" Canvas.Top="192" FontSize="11" Foreground="#8A92A6"/>
                                                     <TextBlock x:Name="TxtLabel_80" Text="80°C" Canvas.Top="192" FontSize="11" Foreground="#8A92A6"/>
                                                     <TextBlock x:Name="TxtLabel_90" Text="90°C" Canvas.Top="192" FontSize="11" Foreground="#8A92A6"/>
                                                 </Canvas>
                                             </Grid>
                                         </Grid>
                                     </Border>
                                    
                                    <!-- Curve Sliders -->
                                    <Grid Margin="0,6,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>
                                        <TextBlock Grid.Row="0" Grid.Column="0" Text="Mốc 30 °C:" VerticalAlignment="Center" Width="80"/>
                                        <Slider Grid.Row="0" Grid.Column="1" Minimum="0" Maximum="100" Value="{Binding CurveP30, Mode=TwoWay}"/>
                                        
                                        <TextBlock Grid.Row="1" Grid.Column="0" Text="Mốc 40 °C:" VerticalAlignment="Center"/>
                                        <Slider Grid.Row="1" Grid.Column="1" Minimum="0" Maximum="100" Value="{Binding CurveP40, Mode=TwoWay}"/>

                                        <TextBlock Grid.Row="2" Grid.Column="0" Text="Mốc 50 °C:" VerticalAlignment="Center"/>
                                        <Slider Grid.Row="2" Grid.Column="1" Minimum="0" Maximum="100" Value="{Binding CurveP50, Mode=TwoWay}"/>

                                        <TextBlock Grid.Row="3" Grid.Column="0" Text="Mốc 60 °C:" VerticalAlignment="Center"/>
                                        <Slider Grid.Row="3" Grid.Column="1" Minimum="0" Maximum="100" Value="{Binding CurveP60, Mode=TwoWay}"/>

                                        <TextBlock Grid.Row="4" Grid.Column="0" Text="Mốc 70 °C:" VerticalAlignment="Center"/>
                                        <Slider Grid.Row="4" Grid.Column="1" Minimum="0" Maximum="100" Value="{Binding CurveP70, Mode=TwoWay}"/>

                                        <TextBlock Grid.Row="5" Grid.Column="0" Text="Mốc 80 °C:" VerticalAlignment="Center"/>
                                        <Slider Grid.Row="5" Grid.Column="1" Minimum="0" Maximum="100" Value="{Binding CurveP80, Mode=TwoWay}"/>

                                        <TextBlock Grid.Row="6" Grid.Column="0" Text="Mốc 90 °C:" VerticalAlignment="Center"/>
                                        <Slider Grid.Row="6" Grid.Column="1" Minimum="0" Maximum="100" Value="{Binding CurveP90, Mode=TwoWay}"/>
                                    </Grid>
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <!-- TAB 2: ĐÈN LED RGB WITH LIVE LED STRIP PREVIEW -->
                        <StackPanel Spacing="18" Visibility="{Binding SelectedTabIndex, Converter={StaticResource IntToVisibilityConverter}, ConverterParameter=2}">
                            <!-- LED Strip Live Simulation Box -->
                            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" CornerRadius="10" Padding="16">
                                <StackPanel Spacing="12">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <FontIcon Glyph="&#xE790;" Foreground="{ThemeResource SystemAccentColor}"/>
                                        <TextBlock Text="MÔ PHỎNG DẢI LED RGB (WS2812B / FASTLED)" FontWeight="Bold" FontSize="14"/>
                                    </StackPanel>
                                    <Border Background="Black" CornerRadius="8" Height="46" Padding="16,0">
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Stretch" VerticalAlignment="Center">
                                            <Border Width="12" Height="12" CornerRadius="6" Background="{Binding SelectedRgbColorHex}"/>
                                            <Border Width="12" Height="12" CornerRadius="6" Background="{Binding SelectedRgbColorHex}"/>
                                            <Border Width="12" Height="12" CornerRadius="6" Background="{Binding SelectedRgbColorHex}"/>
                                            <Border Width="12" Height="12" CornerRadius="6" Background="{Binding SelectedRgbColorHex}"/>
                                            <Border Width="12" Height="12" CornerRadius="6" Background="{Binding SelectedRgbColorHex}"/>
                                            <Border Width="12" Height="12" CornerRadius="6" Background="{Binding SelectedRgbColorHex}"/>
                                            <Border Width="12" Height="12" CornerRadius="6" Background="{Binding SelectedRgbColorHex}"/>
                                            <Border Width="12" Height="12" CornerRadius="6" Background="{Binding SelectedRgbColorHex}"/>
                                            <Border Width="12" Height="12" CornerRadius="6" Background="{Binding SelectedRgbColorHex}"/>
                                            <Border Width="12" Height="12" CornerRadius="6" Background="{Binding SelectedRgbColorHex}"/>
                                            <Border Width="12" Height="12" CornerRadius="6" Background="{Binding SelectedRgbColorHex}"/>
                                            <Border Width="12" Height="12" CornerRadius="6" Background="{Binding SelectedRgbColorHex}"/>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                            </Border>

                            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" CornerRadius="10" Padding="16">
                                <StackPanel Spacing="16">
                                    <TextBlock Text="Cấu Hình Hiệu Ứng Đèn LED RGB" FontSize="16" FontWeight="Bold"/>
                                    
                                    <TextBlock Text="Chế Độ LED RGB:" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                    <ComboBox SelectedIndex="{Binding SelectedLedMode, Mode=TwoWay}" HorizontalAlignment="Stretch">
                                        <ComboBoxItem Content="0. Tắt Đèn (Off)"/>
                                        <ComboBoxItem Content="1. Màu Cố Định (Static)"/>
                                        <ComboBoxItem Content="2. Vòng Cầu Vồng (Rainbow)"/>
                                        <ComboBoxItem Content="3. Nhịp Thở Đơn Màu (Breathing)"/>
                                        <ComboBoxItem Content="4. Đồng Bộ Tốc Độ Quạt (Speed Sync)"/>
                                        <ComboBoxItem Content="5. Sóng Cầu Vồng (Wave)"/>
                                        <ComboBoxItem Content="6. Ngọn Lửa (Fire)"/>
                                        <ComboBoxItem Content="7. Sao Băng Chạy Vòng (Comet / Chase)"/>
                                        <ComboBoxItem Content="8. Quét Màu Nối Tiếp (Color Wipe)"/>
                                        <ComboBoxItem Content="9. Mạch Đập (Pulse)"/>
                                        <ComboBoxItem Content="10. Xoay Đôi 2 Nửa (Dual Spin)"/>
                                    </ComboBox>

                                    <!-- Direction Toggle -->
                                    <Grid Margin="0,4,0,0">
                                        <TextBlock Text="Chiều Quay Hiệu Ứng:" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center"/>
                                        <ToggleSwitch HorizontalAlignment="Right" OnContent="Ngược chiều ↺" OffContent="Xuôi chiều ↻" IsOn="{Binding IsLedReverse, Mode=TwoWay}"/>
                                    </Grid>

                                    <TextBlock Text="Bảng Màu Nhanh (Dùng cho Màu Cố Định / Nhịp Thở):" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <Button Content="Cyan" Command="{Binding SelectRgbPresetColorCommand}" CommandParameter="#00BCD4" Background="#00BCD4" Foreground="Black"/>
                                        <Button Content="Red" Command="{Binding SelectRgbPresetColorCommand}" CommandParameter="#FF5722" Background="#FF5722" Foreground="White"/>
                                        <Button Content="Green" Command="{Binding SelectRgbPresetColorCommand}" CommandParameter="#4CAF50" Background="#4CAF50" Foreground="Black"/>
                                        <Button Content="Purple" Command="{Binding SelectRgbPresetColorCommand}" CommandParameter="#9C27B0" Background="#9C27B0" Foreground="White"/>
                                        <Button Content="Orange" Command="{Binding SelectRgbPresetColorCommand}" CommandParameter="#FF9800" Background="#FF9800" Foreground="Black"/>
                                        <Button Content="White" Command="{Binding SelectRgbPresetColorCommand}" CommandParameter="#FFFFFF" Background="#FFFFFF" Foreground="Black"/>
                                    </StackPanel>

                                    <Grid>
                                        <TextBlock Text="Độ Sáng LED (%):" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                        <TextBlock Text="{Binding RgbBrightness, Converter={StaticResource FloatFormatConverter}, ConverterParameter='{}{0} %'}" HorizontalAlignment="Right" FontWeight="Bold" Foreground="{ThemeResource SystemAccentColor}"/>
                                    </Grid>
                                    <Slider Minimum="0" Maximum="100" Value="{Binding RgbBrightness, Mode=TwoWay}"/>

                                    <Grid>
                                        <TextBlock Text="Tốc Độ Hiệu Ứng (%):" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                        <TextBlock Text="{Binding RgbSpeed, Converter={StaticResource FloatFormatConverter}, ConverterParameter='{}{0} %'}" HorizontalAlignment="Right" FontWeight="Bold" Foreground="{ThemeResource SystemAccentColor}"/>
                                    </Grid>
                                    <Slider Minimum="1" Maximum="100" Value="{Binding RgbSpeed, Mode=TwoWay}"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <!-- TAB 3: GÁN APP AUTO-SWITCH -->
                        <StackPanel Spacing="18" Visibility="{Binding SelectedTabIndex, Converter={StaticResource IntToVisibilityConverter}, ConverterParameter=3}">
                            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" CornerRadius="10" Padding="16">
                                <StackPanel Spacing="14">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="Tự Động Chuyển Profile Theo Ứng Dụng / Game (.exe)" FontSize="16" FontWeight="Bold"/>
                                        <ToggleSwitch Grid.Column="1" Header="Bật Auto-Switch" IsOn="{Binding IsAutoAppSwitchEnabled, Mode=TwoWay}"/>
                                    </Grid>

                                    <!-- Add App Mapping Form -->
                                     <Border Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}" CornerRadius="8" Padding="14" Margin="0,4,0,4">
                                         <StackPanel Spacing="10">
                                             <Grid>
                                                 <TextBlock Text="Thêm Gán Ứng Dụng Mới" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                                 <Button Command="{Binding OpenAppPickerCommand}" HorizontalAlignment="Right" Style="{ThemeResource AccentButtonStyle}" Padding="12,6">
                                                     <StackPanel Orientation="Horizontal" Spacing="6">
                                                         <FontIcon Glyph="&#xE71D;" FontSize="13"/>
                                                         <TextBlock Text="🔍 Chọn Từ App Đang Chạy / Duyệt File..." FontWeight="Bold"/>
                                                     </StackPanel>
                                                 </Button>
                                             </Grid>
                                             <Grid ColumnSpacing="8">
                                                 <Grid.ColumnDefinitions>
                                                     <ColumnDefinition Width="*"/>
                                                     <ColumnDefinition Width="*"/>
                                                     <ColumnDefinition Width="Auto"/>
                                                     <ColumnDefinition Width="Auto"/>
                                                 </Grid.ColumnDefinitions>
                                                 <TextBox Grid.Column="0" PlaceholderText="Tên Ứng Dụng (VD: Genshin Impact)" Text="{Binding NewAppName, Mode=TwoWay}"/>
                                                 <TextBox Grid.Column="1" PlaceholderText="Đường Dẫn Executable (.exe)" Text="{Binding NewExePath, Mode=TwoWay}"/>
                                                 <ComboBox Grid.Column="2" SelectedValue="{Binding SelectedMappingProfileName, Mode=TwoWay}" SelectedValuePath="Content" Width="110">
                                                     <ComboBoxItem Content="Turbo"/>
                                                     <ComboBoxItem Content="Balanced"/>
                                                     <ComboBoxItem Content="Quiet"/>
                                                 </ComboBox>
                                                 <Button Grid.Column="3" Content="Thêm Gán" Command="{Binding AddAppMappingCommand}" Style="{ThemeResource AccentButtonStyle}"/>
                                             </Grid>
                                         </StackPanel>
                                     </Border>

                                    <ListView ItemsSource="{Binding AppMappings}" SelectionMode="None">
                                        <ListView.ItemTemplate>
                                            <DataTemplate>
                                                <Grid ColumnSpacing="12" Padding="4">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel Grid.Column="0">
                                                        <TextBlock Text="{Binding AppName}" FontWeight="Bold"/>
                                                        <TextBlock Text="{Binding ExecutablePath}" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                                    </StackPanel>
                                                    <TextBlock Grid.Column="1" Text="{Binding ProfileName}" VerticalAlignment="Center" FontWeight="SemiBold"/>
                                                    <CheckBox Grid.Column="2" IsChecked="{Binding IsEnabled, Mode=TwoWay}" VerticalAlignment="Center"/>
                                                     <Button Grid.Column="3" x:Name="RemoveAppBtn" Click="RemoveAppBtn_Click" Tag="{Binding}" ToolTipService.ToolTip="Xóa Gán">
                                                        <FontIcon Glyph="&#xE74D;" FontSize="12" Foreground="#FF5722"/>
                                                    </Button>
                                                </Grid>
                                            </DataTemplate>
                                        </ListView.ItemTemplate>
                                    </ListView>
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <!-- TAB 4: THÔNG SỐ PHẦN CỨNG -->
                        <StackPanel Spacing="18" Visibility="{Binding SelectedTabIndex, Converter={StaticResource IntToVisibilityConverter}, ConverterParameter=4}">
                            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" CornerRadius="10" Padding="16">
                                <StackPanel Spacing="14">
                                    <TextBlock Text="Thông Số Cảm Biến Phần Cứng Chi Tiết" FontSize="16" FontWeight="Bold"/>
                                    <Grid RowSpacing="10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>
                                        <TextBlock Grid.Row="0" Grid.Column="0" Text="Nhiệt Độ CPU Package:" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                        <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding CpuTemp, Converter={StaticResource FloatFormatConverter}, ConverterParameter='{}{0:F0} °C'}" FontWeight="Bold"/>

                                        <TextBlock Grid.Row="1" Grid.Column="0" Text="Nhiệt Độ GPU Core:" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                        <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding GpuTemp, Converter={StaticResource FloatFormatConverter}, ConverterParameter='{}{0:F0} °C'}" FontWeight="Bold"/>

                                        <TextBlock Grid.Row="2" Grid.Column="0" Text="RAM Hệ Thống Đã Dùng:" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                        <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding RamStatusText}" FontWeight="Bold"/>

                                        <TextBlock Grid.Row="3" Grid.Column="0" Text="Nhiệt Độ Bo Mạch Chủ:" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                        <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding MotherboardTemp, Converter={StaticResource FloatFormatConverter}, ConverterParameter='{}{0:F0} °C'}" FontWeight="Bold"/>
                                    </Grid>
                                </StackPanel>
                            </Border>
                        </StackPanel>



                        <!-- TAB 5: DUAL OLED CUSTOM CANVAS (INDEPENDENT CONTROL FOR OLED 1 & OLED 2) -->
                        <StackPanel Spacing="18" Visibility="{Binding SelectedTabIndex, Converter={StaticResource IntToVisibilityConverter}, ConverterParameter=5}">
                            <Grid ColumnSpacing="18">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <!-- SCREEN 1: OLED 1.3" CUSTOMIZER -->
                                <Border Grid.Column="0" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" CornerRadius="12" Padding="20" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                                    <StackPanel Spacing="16">
                                        <Grid>
                                            <StackPanel Orientation="Horizontal" Spacing="10">
                                                <FontIcon Glyph="&#xE7F4;" Foreground="#00BCD4" FontSize="20"/>
                                                <StackPanel>
                                                    <TextBlock Text="Màn Hình 1: OLED 1.3&quot;" FontSize="16" FontWeight="Bold"/>
                                                    <TextBlock Text="Giao diện độc lập màn 1.3 inch (128x64)" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                                </StackPanel>
                                            </StackPanel>
                                            <ToggleSwitch IsOn="{Binding IsCustomOled1Enabled, Mode=TwoWay}" OnContent="Bật Custom" OffContent="Tắt (Mặc định)" HorizontalAlignment="Right"/>
                                        </Grid>

                                        <TextBox Header="Tiêu đề Hàng Trên (Title Bar)" Text="{Binding Oled1CustomTitle, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                                        <TextBox Header="Thông số Chính (Main Stat Text)" Text="{Binding Oled1CustomMainStat, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                                        <TextBox Header="Thông số Phụ (Sub Stat Text)" Text="{Binding Oled1CustomSubStat, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>

                                        <StackPanel Orientation="Horizontal" Spacing="20">
                                            <CheckBox Content="Hiện Thanh Bar PWM" IsChecked="{Binding Oled1ShowBar, Mode=TwoWay}"/>
                                            <Button Content="Cập Nhật Ngay Màn 1" Command="{Binding SendCustomOled1FrameCommand}" Style="{StaticResource AccentButtonStyle}"/>
                                        </StackPanel>
                                    </StackPanel>
                                </Border>

                                <!-- SCREEN 2: OLED 0.96" CUSTOMIZER -->
                                <Border Grid.Column="1" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" CornerRadius="12" Padding="20" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                                    <StackPanel Spacing="16">
                                        <Grid>
                                            <StackPanel Orientation="Horizontal" Spacing="10">
                                                <FontIcon Glyph="&#xE9E9;" Foreground="#FF9800" FontSize="20"/>
                                                <StackPanel>
                                                    <TextBlock Text="Màn Hình 2: OLED 0.96&quot;" FontSize="16" FontWeight="Bold"/>
                                                    <TextBlock Text="Giao diện độc lập màn 0.96 inch (128x64)" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                                </StackPanel>
                                            </StackPanel>
                                            <ToggleSwitch IsOn="{Binding IsCustomOled2Enabled, Mode=TwoWay}" OnContent="Bật Custom" OffContent="Tắt (Mặc định)" HorizontalAlignment="Right"/>
                                        </Grid>

                                        <TextBox Header="Hàng Trên Cùng (Header Text)" Text="{Binding Oled2CustomHeader, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                                        <TextBox Header="Dòng Thông Số CPU" Text="{Binding Oled2CustomCpuText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                                        <TextBox Header="Dòng Thông Số GPU" Text="{Binding Oled2CustomGpuText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                                        <TextBox Header="Dòng Trạng Thái Đáy (Footer)" Text="{Binding Oled2CustomFooter, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>

                                        <Button Content="Cập Nhật Ngay Màn 2" Command="{Binding SendCustomOled2FrameCommand}" Style="{StaticResource AccentButtonStyle}"/>
                                    </StackPanel>
                                </Border>
                            </Grid>
                        </StackPanel>

                        <!-- TAB 6: HUD OVERLAY GAME/APP (1:1 PARITY WITH FLUTTER OVERLAY_SETTINGS_SCREEN.DART) -->
                        <StackPanel Spacing="18" Visibility="{Binding SelectedTabIndex, Converter={StaticResource IntToVisibilityConverter}, ConverterParameter=6}">
                            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" CornerRadius="12" Padding="20">
                                <StackPanel Spacing="18">
                                    <!-- Header Title & Master Controls Bar -->
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="10">
                                            <FontIcon Glyph="&#xE7F4;" Foreground="{ThemeResource SystemAccentColor}" FontSize="22"/>
                                            <StackPanel>
                                                <TextBlock Text="CẤU HÌNH HIỂN THỊ HUD OVERLAY (IN-GAME OSD TELEMETRY)" FontSize="15" FontWeight="Bold"/>
                                                <TextBlock Text="Tùy chỉnh các chỉ số nhiệt độ, quạt, công suất hiển thị thả nổi trên game và các ứng dụng khác" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                            </StackPanel>
                                        </StackPanel>

                                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                                            <ToggleSwitch Header="Bật Overlay HUD" IsOn="{Binding IsOverlayEnabled, Mode=TwoWay}"/>
                                            <Button Content="Khôi Phục Mặc Định" Command="{Binding ResetOverlayConfigCommand}" Margin="8,0,0,0"/>
                                        </StackPanel>
                                    </Grid>

                                    <!-- Responsive 2-Column Grid -->
                                    <Grid ColumnSpacing="20">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="5*"/>
                                            <ColumnDefinition Width="5*"/>
                                        </Grid.ColumnDefinitions>

                                        <!-- LEFT COLUMN: Live Preview, Position, Style, Opacity -->
                                        <StackPanel Grid.Column="0" Spacing="16">
                                            
                                            <!-- Live Preview Box -->
                                            <TextBlock Text="PREVIEW MÀN HÌNH HUD OVERLAY THỰC TẾ" FontWeight="Bold" FontSize="13"/>
                                            <Border Background="#10141D" CornerRadius="12" Height="170" Padding="16" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                                                <Grid>
                                                    <!-- Simulated Background Game Pattern -->
                                                    <TextBlock Text="[GAME DISPLAY ENVIRONMENT SIMULATION]" Foreground="#33FFFFFF" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="12" FontWeight="Bold"/>
                                                    
                                                    <!-- Live Preview Badge (Game PP Pill Style) -->
                                                    <StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Left" VerticalAlignment="Top">
                                                        <Border Background="#CC000000" CornerRadius="4" Padding="8,4">
                                                            <StackPanel Orientation="Horizontal" Spacing="6">
                                                                <TextBlock Text="TIME" FontSize="10" Foreground="#A0AAB8" FontWeight="Bold"/>
                                                                <TextBlock Text="16:30:00" FontSize="11" Foreground="#FFFFFF" FontWeight="Bold"/>
                                                            </StackPanel>
                                                        </Border>
                                                        <Border Background="#CC000000" CornerRadius="4" Padding="8,4">
                                                            <StackPanel Orientation="Horizontal" Spacing="6">
                                                                <TextBlock Text="CPU" FontSize="10" Foreground="#A0AAB8" FontWeight="Bold"/>
                                                                <TextBlock Text="{Binding CpuUsage, Converter={StaticResource FloatFormatConverter}, ConverterParameter='{}{0:F0}%'}" FontSize="11" Foreground="#00E676" FontWeight="Bold"/>
                                                                <TextBlock Text="{Binding CpuTemp, Converter={StaticResource FloatFormatConverter}, ConverterParameter='{}{0:F0}°C'}" FontSize="11" Foreground="#00E676" FontWeight="Bold"/>
                                                                <TextBlock Text="{Binding CpuPowerW, Converter={StaticResource FloatFormatConverter}, ConverterParameter='{}{0:F0}W'}" FontSize="11" Foreground="#00D2FF" FontWeight="Bold"/>
                                                            </StackPanel>
                                                        </Border>
                                                        <Border Background="#CC000000" CornerRadius="4" Padding="8,4">
                                                            <StackPanel Orientation="Horizontal" Spacing="6">
                                                                <TextBlock Text="GPU" FontSize="10" Foreground="#A0AAB8" FontWeight="Bold"/>
                                                                <TextBlock Text="{Binding GpuUsage, Converter={StaticResource FloatFormatConverter}, ConverterParameter='{}{0:F0}%'}" FontSize="11" Foreground="#00E676" FontWeight="Bold"/>
                                                                <TextBlock Text="{Binding GpuTemp, Converter={StaticResource FloatFormatConverter}, ConverterParameter='{}{0:F0}°C'}" FontSize="11" Foreground="#00E676" FontWeight="Bold"/>
                                                                <TextBlock Text="{Binding GpuPowerW, Converter={StaticResource FloatFormatConverter}, ConverterParameter='{}{0:F0}W'}" FontSize="11" Foreground="#00D2FF" FontWeight="Bold"/>
                                                            </StackPanel>
                                                        </Border>
                                                        <Border Background="#CC000000" CornerRadius="4" Padding="8,4">
                                                            <StackPanel Orientation="Horizontal" Spacing="6">
                                                                <TextBlock Text="LLANO FAN" FontSize="10" Foreground="#A0AAB8" FontWeight="Bold"/>
                                                                <TextBlock Text="{Binding FanRpm, Converter={StaticResource FloatFormatConverter}, ConverterParameter='{}{0} RPM'}" FontSize="11" Foreground="#00E5FF" FontWeight="Bold"/>
                                                            </StackPanel>
                                                        </Border>
                                                    </StackPanel>
                                                </Grid>
                                            </Border>

                                            <!-- Position & Drag Control -->
                                            <TextBlock Text="VỊ TRÍ VÀ DI CHUYỂN HUD (POSITION &amp; DRAG)" FontWeight="Bold" FontSize="13"/>
                                            <Button Command="{Binding ToggleOverlayLockCommand}" HorizontalAlignment="Stretch" Padding="12">
                                                 <TextBlock Text="{Binding OverlayLockStatusText}" FontWeight="Bold" TextWrapping="Wrap"/>
                                             </Button>
                                             <TextBlock Text="CHỌN NHANH VỊ TRÍ MẶC ĐỊNH (TỰ ĐỘNG CHÍNH XÁC 100%):" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                             <StackPanel Orientation="Horizontal" Spacing="6">
                                                 <Button Content="{Binding PresetTopLeftText}" Command="{Binding SetOverlayPositionPresetCommand}" CommandParameter="top_left"/>
                                                 <Button Content="{Binding PresetTopCenterText}" Command="{Binding SetOverlayPositionPresetCommand}" CommandParameter="top_center"/>
                                                 <Button Content="{Binding PresetTopRightText}" Command="{Binding SetOverlayPositionPresetCommand}" CommandParameter="top_right"/>
                                                 <Button Content="{Binding PresetBottomLeftText}" Command="{Binding SetOverlayPositionPresetCommand}" CommandParameter="bottom_left"/>
                                                 <Button Content="{Binding PresetBottomCenterText}" Command="{Binding SetOverlayPositionPresetCommand}" CommandParameter="bottom_center"/>
                                                 <Button Content="{Binding PresetBottomRightText}" Command="{Binding SetOverlayPositionPresetCommand}" CommandParameter="bottom_right"/>
                                             </StackPanel>

                                            <!-- Style & Opacity -->
                                            <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                                                <TextBlock Text="ĐỘ TRONG SUỐT NỀN HUD (OPACITY):" FontWeight="Bold" FontSize="12" VerticalAlignment="Center"/>
                                                <Border Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}" CornerRadius="4" Padding="8,2">
                                                    <TextBlock Text="{Binding OverlayBackgroundOpacityPercentText}" FontWeight="Bold" FontSize="12" Foreground="{ThemeResource SystemAccentColor}"/>
                                                </Border>
                                            </StackPanel>
                                            <Slider Minimum="0.0" Maximum="1.0" StepFrequency="0.05" Value="{Binding OverlayBackgroundOpacity, Mode=TwoWay}"/>

                                             <!-- Font Size Scale Selector (1080, 2K, 4K) -->
                                             <TextBlock Text="KÍCH THƯỚC PHÔNG CHỮ HUD (FONT SIZE SCALE):" FontWeight="Bold" FontSize="12"/>
                                             <ComboBox SelectedValue="{Binding OverlayFontSizeScale, Mode=TwoWay}" SelectedValuePath="Tag" HorizontalAlignment="Stretch">
                                                 <ComboBoxItem Content="1080p (Chữ Nhỏ - Màn Full HD)" Tag="1080"/>
                                                 <ComboBoxItem Content="2K (Chữ Vừa - Màn 1440p)" Tag="2K"/>
                                                 <ComboBoxItem Content="4K (Chữ Lớn - Màn 4K Ultra HD)" Tag="4K"/>
                                             </ComboBox>
                                        </StackPanel>

                                        <!-- RIGHT COLUMN: Category Sub-Tabs (Basic, CPU, GPU, Memory, Llano Fan) -->
                                        <StackPanel Grid.Column="1" Spacing="14">
                                            <TextBlock Text="CHỌN THÔNG SỐ NỘI DUNG HIỂN THỊ (MONITORING CONTENT)" FontWeight="Bold" FontSize="13"/>

                                            <!-- Sub-Tab Header Bar matching Game PP / Armoury Crate -->
                                            <Border Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}" CornerRadius="8" Padding="4">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="*"/>
                                                    </Grid.ColumnDefinitions>
                                                    <Button Grid.Column="0" Content="{Binding SubTabBasicText}" Command="{Binding SelectOverlayCategoryTabCommand}" CommandParameter="0" HorizontalAlignment="Stretch" Padding="4,6"/>
                                                    <Button Grid.Column="1" Content="{Binding SubTabCpuText}" Command="{Binding SelectOverlayCategoryTabCommand}" CommandParameter="1" HorizontalAlignment="Stretch" Padding="4,6"/>
                                                    <Button Grid.Column="2" Content="{Binding SubTabGpuText}" Command="{Binding SelectOverlayCategoryTabCommand}" CommandParameter="2" HorizontalAlignment="Stretch" Padding="4,6"/>
                                                    <Button Grid.Column="3" Content="{Binding SubTabMemoryText}" Command="{Binding SelectOverlayCategoryTabCommand}" CommandParameter="3" HorizontalAlignment="Stretch" Padding="4,6"/>
                                                    <Button Grid.Column="4" Content="{Binding SubTabFanText}" Command="{Binding SelectOverlayCategoryTabCommand}" CommandParameter="4" HorizontalAlignment="Stretch" Padding="4,6"/>
                                                </Grid>
                                            </Border>

                                            <!-- Category Panel Content -->
                                            <Border Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}" CornerRadius="10" Padding="16">
                                                <StackPanel Spacing="12">
                                                    <!-- Sub-tab 0: Basic -->
                                                    <StackPanel Spacing="10" Visibility="{Binding ActiveOverlayCategoryTab, Converter={StaticResource IntToVisibilityConverter}, ConverterParameter=0}">
                                                        <TextBlock Text="CHẾ ĐỘ HIỂN THỊ OVERLAY" FontWeight="Bold" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                                        <ComboBox SelectedValue="{Binding SelectedDisplayMode, Mode=TwoWay}" SelectedValuePath="Tag" HorizontalAlignment="Stretch">
                                                            <ComboBoxItem Content="Luôn hiển thị trên màn hình" Tag="always"/>
                                                            <ComboBoxItem Content="Chỉ hiển thị khi chạy Game" Tag="game_only"/>
                                                        </ComboBox>
                                                        <CheckBox Content="Hiển Thị Tốc Độ Khung Hình (FPS Counter)" IsChecked="{Binding ShowFps, Mode=TwoWay}"/>
                                                    </StackPanel>

                                                    <!-- Sub-tab 1: CPU -->
                                                    <StackPanel Spacing="10" Visibility="{Binding ActiveOverlayCategoryTab, Converter={StaticResource IntToVisibilityConverter}, ConverterParameter=1}">
                                                        <TextBlock Text="THÔNG SỐ VI XỬ LÝ CPU" FontWeight="Bold" FontSize="12" Foreground="{ThemeResource SystemAccentColor}"/>
                                                        <CheckBox Content="Hiển Thị Nhiệt Độ CPU Package (°C)" IsChecked="{Binding ShowCpuTemp, Mode=TwoWay}"/>
                                                        <CheckBox Content="Hiển Thị Mức Sử Dụng CPU Package (%)" IsChecked="{Binding ShowCpuUsage, Mode=TwoWay}"/>
                                                        <Grid ColumnSpacing="12">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="*"/>
                                                                <ColumnDefinition Width="Auto"/>
                                                            </Grid.ColumnDefinitions>
                                                            <CheckBox Grid.Column="0" Content="Hiển Thị Tốc Độ Xung Nhịp CPU" IsChecked="{Binding ShowCpuClock, Mode=TwoWay}" VerticalAlignment="Center"/>
                                                            <ComboBox Grid.Column="1" SelectedValue="{Binding CpuClockUnit, Mode=TwoWay}" SelectedValuePath="Tag" Width="90">
                                                                <ComboBoxItem Content="GHz" Tag="GHz"/>
                                                                <ComboBoxItem Content="MHz" Tag="MHz"/>
                                                            </ComboBox>
                                                        </Grid>
                                                        <CheckBox Content="Hiển Thị Công Suất Điện CPU (Watt)" IsChecked="{Binding ShowCpuPower, Mode=TwoWay}"/>
                                                        <CheckBox Content="Hiển Thị Tốc Độ Quạt CPU Laptop (RPM)" IsChecked="{Binding ShowHardwareCpuFanRpm, Mode=TwoWay}"/>
                                                    </StackPanel>

                                                    <!-- Sub-tab 2: GPU -->
                                                    <StackPanel Spacing="10" Visibility="{Binding ActiveOverlayCategoryTab, Converter={StaticResource IntToVisibilityConverter}, ConverterParameter=2}">
                                                        <TextBlock Text="THÔNG SỐ CARD ĐỒ HỌA GPU" FontWeight="Bold" FontSize="12" Foreground="#0070F3"/>
                                                        <CheckBox Content="Hiển Thị Nhiệt Độ GPU Core (°C)" IsChecked="{Binding ShowGpuTemp, Mode=TwoWay}"/>
                                                        <CheckBox Content="Hiển Thị Mức Sử Dụng GPU Core (%)" IsChecked="{Binding ShowGpuUsage, Mode=TwoWay}"/>
                                                        <Grid ColumnSpacing="12">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="*"/>
                                                                <ColumnDefinition Width="Auto"/>
                                                            </Grid.ColumnDefinitions>
                                                            <CheckBox Grid.Column="0" Content="Hiển Thị Tốc Độ Xung Nhịp GPU" IsChecked="{Binding ShowGpuClock, Mode=TwoWay}" VerticalAlignment="Center"/>
                                                            <ComboBox Grid.Column="1" SelectedValue="{Binding GpuClockUnit, Mode=TwoWay}" SelectedValuePath="Tag" Width="90">
                                                                <ComboBoxItem Content="MHz" Tag="MHz"/>
                                                                <ComboBoxItem Content="GHz" Tag="GHz"/>
                                                            </ComboBox>
                                                        </Grid>
                                                        <CheckBox Content="Hiển Thị Công Suất Điện GPU (Watt)" IsChecked="{Binding ShowGpuPower, Mode=TwoWay}"/>
                                                        <CheckBox Content="Hiển Thị Dung Lượng VRAM GPU Đã Dùng (GB)" IsChecked="{Binding ShowGpuVram, Mode=TwoWay}"/>
                                                        <CheckBox Content="Hiển Thị Tốc Độ Quạt GPU Laptop (RPM)" IsChecked="{Binding ShowHardwareGpuFanRpm, Mode=TwoWay}"/>
                                                    </StackPanel>

                                                    <!-- Sub-tab 3: Memory -->
                                                    <StackPanel Spacing="10" Visibility="{Binding ActiveOverlayCategoryTab, Converter={StaticResource IntToVisibilityConverter}, ConverterParameter=3}">
                                                        <TextBlock Text="THÔNG SỐ BỘ NHỚ RAM" FontWeight="Bold" FontSize="12" Foreground="#38BDF8"/>
                                                        <CheckBox Content="Hiển Thị % RAM Hệ Thống Đã Dùng" IsChecked="{Binding ShowRamUsage, Mode=TwoWay}"/>
                                                    </StackPanel>

                                                    <!-- Sub-tab 4: Smart Fan -->
                                                    <StackPanel Spacing="10" Visibility="{Binding ActiveOverlayCategoryTab, Converter={StaticResource IntToVisibilityConverter}, ConverterParameter=4}">
                                                        <TextBlock Text="THÔNG SỐ QUẠT TẢN NHIỆT (SMART FAN)" FontWeight="Bold" FontSize="12" Foreground="#00E5FF"/>
                                                        <CheckBox Content="Hiển Thị Tốc Độ Vòng Quay Quạt (RPM)" IsChecked="{Binding ShowSmartFanRpm, Mode=TwoWay}"/>
                                                        <CheckBox Content="Hiển Thị Mức PWM Đầu Ra (%)" IsChecked="{Binding ShowSmartFanPwm, Mode=TwoWay}"/>
                                                    </StackPanel>
                                                </StackPanel>
                                            </Border>
                                        </StackPanel>
                                    </Grid>
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <!-- TAB 7: THIẾT LẬP HỆ THỐNG (SETTINGS) -->
                        <StackPanel Spacing="18" Visibility="{Binding SelectedTabIndex, Converter={StaticResource IntToVisibilityConverter}, ConverterParameter=7}">
                            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" CornerRadius="10" Padding="16">
                                <StackPanel Spacing="14">
                                    <TextBlock Text="Thiết Lập Hệ Thống &amp; Cấu Hình Ứng Dụng" FontSize="16" FontWeight="Bold"/>
                                    
                                    <ToggleSwitch Header="Khởi Động Cùng Windows" IsOn="{Binding StartWithWindows, Mode=TwoWay}"/>
                                    <ToggleSwitch Header="Thu Nhỏ Xuống Khay Hệ Thống (System Tray) Khi Đóng" IsOn="{Binding MinimizeToTray, Mode=TwoWay}"/>

                                    <TextBlock Text="Tốc Độ Baud Rate Cổng Serial COM:" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                    <ComboBox SelectedValue="{Binding SelectedBaudRate, Mode=TwoWay}" SelectedValuePath="Content" HorizontalAlignment="Stretch">
                                        <ComboBoxItem Content="9600"/>
                                        <ComboBoxItem Content="115200"/>
                                        <ComboBoxItem Content="230400"/>
                                        <ComboBoxItem Content="921600"/>
                                    </ComboBox>

                                    <TextBlock Text="Tần Số Cập Nhật Cảm Biến Phần Cứng (ms):" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                    <Slider Minimum="250" Maximum="5000" StepFrequency="250" Value="{Binding RefreshIntervalMs, Mode=TwoWay}"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>

                    </Grid>
                </ScrollViewer>

                <!-- Status Footer Bar -->
                <Border Grid.Row="2" Padding="16,6" Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}">
                    <TextBlock Text="{Binding StatusMessage}" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                </Border>
            </Grid>

        </NavigationView>

        <!-- APP PICKER POPUP MODAL DIALOG OVERLAY -->
        <Grid Visibility="{Binding IsAppPickerOpen, Converter={StaticResource BoolToVisibilityConverter}}"
              Background="#D0000000" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
            <Border Background="#161820" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1"
                    CornerRadius="14" Width="680" Height="520" HorizontalAlignment="Center" VerticalAlignment="Center" Padding="20">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Dialog Header -->
                    <Grid Grid.Row="0" Margin="0,0,0,14">
                        <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                            <FontIcon Glyph="&#xE71D;" Foreground="{ThemeResource SystemAccentColor}" FontSize="20"/>
                            <StackPanel>
                                <TextBlock Text="CHỌN ỨNG DỤNG HOẶC GAME ĐANG CHẠY TRÊN HỆ THỐNG" FontWeight="Bold" FontSize="15"/>
                                <TextBlock Text="Nhấp vào ứng dụng trong danh sách bên dưới hoặc bấm Duyệt File .exe để tự động gán." FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                            </StackPanel>
                        </StackPanel>
                        <Button Command="{Binding CloseAppPickerCommand}" HorizontalAlignment="Right" VerticalAlignment="Top" Padding="8,4">
                            <FontIcon Glyph="&#xE711;" FontSize="12"/>
                        </Button>
                    </Grid>

                    <!-- Search Box & Browse File Button -->
                    <Grid Grid.Row="1" Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox Text="{Binding AppPickerSearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                 PlaceholderText="🔍 Tìm kiếm ứng dụng đang chạy (VD: Chrome, Game.exe, Valorant...)" Margin="0,0,10,0"/>
                        <Button Grid.Column="1" Click="BrowseExeFile_Click" Style="{ThemeResource AccentButtonStyle}" Padding="12,6">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <FontIcon Glyph="&#xE8B7;" FontSize="13"/>
                                <TextBlock Text="Duyệt File .exe" FontWeight="Bold"/>
                            </StackPanel>
                        </Button>
                    </Grid>

                    <!-- Running Apps ListView -->
                    <Border Grid.Row="2" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8">
                        <ListView ItemsSource="{Binding FilteredRunningApps}" SelectionMode="Single" ItemClick="RunningAppsListView_ItemClick" IsItemClickEnabled="True">
                            <ListView.ItemTemplate>
                                <DataTemplate>
                                    <Grid Padding="12,8" Margin="0,2">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <FontIcon Glyph="&#xE737;" Foreground="{ThemeResource SystemAccentColor}" FontSize="18" Margin="0,0,12,0" VerticalAlignment="Center"/>
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,10,0">
                                            <TextBlock Text="{Binding Name}" FontWeight="Bold" FontSize="13"/>
                                            <TextBlock Text="{Binding ExecutablePath}" FontSize="10" Foreground="#8A92A6" TextTrimming="CharacterEllipsis"/>
                                        </StackPanel>
                                        <Border Grid.Column="2" Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}" CornerRadius="4" Padding="8,4" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding ProcessName}" FontSize="10" FontWeight="Bold" Foreground="{ThemeResource SystemAccentColor}"/>
                                        </Border>
                                    </Grid>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                    </Border>

                    <!-- Dialog Footer Buttons -->
                    <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="10" Margin="0,14,0,0">
                        <Button Command="{Binding RefreshRunningAppsCommand}" Padding="12,6">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <FontIcon Glyph="&#xE72C;" FontSize="12"/>
                                <TextBlock Text="Làm mới danh sách"/>
                            </StackPanel>
                        </Button>
                        <Button Command="{Binding CloseAppPickerCommand}" Content="Đóng" Padding="16,6"/>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>

        <!-- ESP32 BLE & WIFI PROVISIONING POPUP MODAL DIALOG OVERLAY -->
        <Grid Visibility="{Binding IsEspConnectionDialogOpen, Converter={StaticResource BoolToVisibilityConverter}}"
              Background="#D0000000" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
            <Border Background="#161820" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1"
                    CornerRadius="14" Width="680" Height="530" HorizontalAlignment="Center" VerticalAlignment="Center" Padding="20">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Header -->
                    <Grid Grid.Row="0" Margin="0,0,0,14">
                        <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                            <FontIcon Glyph="&#xE702;" Foreground="{ThemeResource SystemAccentColor}" FontSize="22"/>
                            <StackPanel>
                                <TextBlock Text="KẾT NỐI &amp; CẤU HÌNH WI-FI CHO ESP32-S3" FontWeight="Bold" FontSize="16"/>
                                <TextBlock Text="Quét kết nối Bluetooth BLE hoặc nạp SSID/Password Wi-Fi cho quạt làm mát." FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                            </StackPanel>
                        </StackPanel>
                        <Button Command="{Binding CloseEspConnectionDialogCommand}" HorizontalAlignment="Right" VerticalAlignment="Top" Padding="8,4">
                            <FontIcon Glyph="&#xE711;" FontSize="12"/>
                        </Button>
                    </Grid>

                    <!-- Dialog Segmented Tabs -->
                    <Grid Grid.Row="1" Margin="0,0,0,14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Button Grid.Column="0" Command="{Binding OpenEspConnectionDialogCommand}" CommandParameter="0" HorizontalAlignment="Stretch" Margin="0,0,4,0">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <FontIcon Glyph="&#xE702;" Foreground="#00BCD4" FontSize="13"/>
                                <TextBlock Text="1. Quét Bluetooth BLE" FontWeight="Bold"/>
                            </StackPanel>
                        </Button>
                        <Button Grid.Column="1" Command="{Binding OpenEspConnectionDialogCommand}" CommandParameter="1" HorizontalAlignment="Stretch" Margin="2,0,2,0">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <FontIcon Glyph="&#xE701;" Foreground="#FF9800" FontSize="13"/>
                                <TextBlock Text="2. Cấu Hình Wi-Fi (SSID)" FontWeight="Bold"/>
                            </StackPanel>
                        </Button>
                        <Button Grid.Column="2" Command="{Binding OpenEspConnectionDialogCommand}" CommandParameter="2" HorizontalAlignment="Stretch" Margin="4,0,0,0">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <FontIcon Glyph="&#xE839;" Foreground="#4CAF50" FontSize="13"/>
                                <TextBlock Text="3. IP Wi-Fi Trực Tiếp" FontWeight="Bold"/>
                            </StackPanel>
                        </Button>
                    </Grid>

                    <!-- Body Content -->
                    <Grid Grid.Row="2">
                        <!-- TAB 0: REAL CONTINUOUS BLE SCAN & CONNECT -->
                        <StackPanel Visibility="{Binding EspDialogSelectedTab, Converter={StaticResource IntToVisibilityConverter}, ConverterParameter=0}" Spacing="12">
                            <Grid>
                                <TextBlock Text="{Binding BleConnectionStatus}" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center"/>
                                <Border HorizontalAlignment="Right" Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}" CornerRadius="6" Padding="10,5">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <ProgressRing IsActive="{Binding IsScanningBle}" Width="14" Height="14"/>
                                        <TextBlock Text="Đang Quét Liên Tục (Real-Time)" FontSize="11" FontWeight="Bold" Foreground="{ThemeResource SystemAccentColor}"/>
                                    </StackPanel>
                                </Border>
                            </Grid>

                            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8" Height="280">
                                <ItemsControl ItemsSource="{Binding ScannedBleDevices}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="0,0,0,1" Padding="12,10">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <FontIcon Glyph="&#xE702;" Foreground="#00BCD4" FontSize="20" Margin="0,0,12,0" VerticalAlignment="Center"/>
                                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding Name}" FontWeight="Bold" FontSize="14"/>
                                                        <TextBlock Text="{Binding MacAddress}" FontSize="10" Foreground="#8A92A6"/>
                                                    </StackPanel>
                                                    <TextBlock Grid.Column="2" Text="{Binding SignalText}" FontSize="11" Foreground="#4CAF50" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,16,0"/>
                                                    <Button Grid.Column="3" Content="Kết Nối BLE" Click="BleDeviceBtn_Click" Tag="{Binding}" Style="{ThemeResource AccentButtonStyle}" Padding="12,5"/>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </Border>
                        </StackPanel>

                        <!-- TAB 1: WI-FI PROVISIONING (NẠP SSID/PASSWORD CHO ESP32) -->
                        <StackPanel Visibility="{Binding EspDialogSelectedTab, Converter={StaticResource IntToVisibilityConverter}, ConverterParameter=1}" Spacing="14">
                            <TextBlock Text="Nạp Cấu Hình Wi-Fi Vào Chip ESP32-S3" FontWeight="Bold" FontSize="14"/>
                            <TextBlock Text="ESP32 sẽ nhận Tên Mạng và Mật Khẩu Wi-Fi này để tự động kết nối vào Router nhà anh." FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>

                            <Border Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}" CornerRadius="10" Padding="16" Margin="0,4">
                                <StackPanel Spacing="12">
                                    <TextBlock Text="Tên Mạng Wi-Fi (SSID):" FontSize="12" FontWeight="SemiBold"/>
                                    <TextBox Text="{Binding WifiSsid, Mode=TwoWay}" PlaceholderText="Ví dụ: MyHomeWiFi_5G"/>

                                    <TextBlock Text="Mật Khẩu Wi-Fi (Password):" FontSize="12" FontWeight="SemiBold"/>
                                    <TextBox Text="{Binding WifiPassword, Mode=TwoWay}" PlaceholderText="Nhập mật khẩu Wi-Fi"/>

                                    <Button Command="{Binding SendWifiProvisioningCommand}" Style="{ThemeResource AccentButtonStyle}" HorizontalAlignment="Stretch" Padding="12,8" Margin="0,6,0,0">
                                        <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center">
                                            <FontIcon Glyph="&#xE701;" FontSize="14"/>
                                            <TextBlock Text="GỬI CẤU HÌNH WI-FI SANG ESP32-S3" FontWeight="Bold"/>
                                        </StackPanel>
                                    </Button>
                                </StackPanel>
                            </Border>
                            <TextBlock Text="{Binding WifiProvisionStatus}" FontSize="11" Foreground="{ThemeResource SystemAccentColor}" FontWeight="SemiBold"/>
                        </StackPanel>

                        <!-- TAB 2: WI-FI IP DIRECT -->
                        <StackPanel Visibility="{Binding EspDialogSelectedTab, Converter={StaticResource IntToVisibilityConverter}, ConverterParameter=2}" Spacing="14">
                            <TextBlock Text="Kết Nối Trực Tiếp Qua Địa Chỉ IP Wi-Fi" FontWeight="Bold" FontSize="14"/>
                            <TextBlock Text="Khi ESP32 đã vào Wi-Fi, anh chỉ cần nhập địa chỉ IP của quạt để điều khiển qua mạng LAN." FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>

                            <Border Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}" CornerRadius="10" Padding="16" Margin="0,4">
                                <StackPanel Spacing="12">
                                    <TextBlock Text="Địa Chỉ IP Mạng Wi-Fi ESP32:" FontSize="12" FontWeight="SemiBold"/>
                                    <TextBox Text="{Binding WifiIpAddress, Mode=TwoWay}" PlaceholderText="192.168.1.100 hoặc smartfan.local"/>

                                    <Button Command="{Binding ConnectWifiIpDirectCommand}" Style="{ThemeResource AccentButtonStyle}" HorizontalAlignment="Stretch" Padding="12,8" Margin="0,6,0,0">
                                        <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center">
                                            <FontIcon Glyph="&#xE839;" FontSize="14"/>
                                            <TextBlock Text="KẾT NỐI QUA WI-FI IP" FontWeight="Bold"/>
                                        </StackPanel>
                                    </Button>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Grid>

                    <!-- Footer -->
                    <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="10" Margin="0,14,0,0">
                        <Button Command="{Binding CloseEspConnectionDialogCommand}" Content="Đóng" Padding="16,6"/>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>
