<UserControl
    x:Class="SmartFanCooling.Views.OledStudio.OledCustomizerView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:converters="using:SmartFanCooling.Converters">

    <UserControl.Resources>
        <converters:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter"/>
    </UserControl.Resources>

    <StackPanel Spacing="18">
        <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" CornerRadius="12" Padding="20" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
            <StackPanel Spacing="20">
                <!-- Master Header & Screen Switcher Bar -->
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="12">
                        <FontIcon Glyph="&#xE7B8;" Foreground="{ThemeResource SystemAccentColor}" FontSize="24"/>
                        <StackPanel>
                            <TextBlock Text="{Binding ActiveOledScreenTitle}" FontSize="16" FontWeight="Bold"/>
                            <TextBlock Text="Tùy biến số dòng, đường phân cách pixel, gán các chỉ số CPU/GPU/Quạt/RAM theo vị trí muốn hiển thị" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                        </StackPanel>
                    </StackPanel>

                    <!-- Screen Selector Buttons -->
                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                        <Button Content="{Binding Oled1TabButtonText}" Command="{Binding SelectOledScreenTabCommand}" CommandParameter="0"/>
                        <Button Content="{Binding Oled2TabButtonText}" Command="{Binding SelectOledScreenTabCommand}" CommandParameter="1"/>
                    </StackPanel>
                </Grid>

                <!-- Main 2-Column Configurator Layout -->
                <Grid ColumnSpacing="20">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="5*"/>
                        <ColumnDefinition Width="5*"/>
                    </Grid.ColumnDefinitions>

                    <!-- LEFT COLUMN: REALTIME PIXEL CANVAS PREVIEW & LAYOUT STRUCTURE -->
                    <StackPanel Grid.Column="0" Spacing="16">
                        <TextBlock Text="PREVIEW MÀN HÌNH OLED 128x64 PIXELS (REAL-TIME CANVAS)" FontWeight="Bold" FontSize="13"/>
                        
                        <!-- REAL PHYSICAL OLED DISPLAY MODULE FRAME (EXACT 2:1 ASPECT RATIO FOR 128x64 PIXELS) -->
                        <Border Background="#0B0F19" BorderBrush="#1E283A" BorderThickness="2" CornerRadius="12" Padding="14,12" HorizontalAlignment="Center" Width="370">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <!-- Top PCB Screw Holes & Hardware Model Label -->
                                <Grid Grid.Row="0" Margin="0,0,0,8">
                                    <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                        <Ellipse Width="10" Height="10" Fill="#162030" Stroke="#3D506A" StrokeThickness="1.5"/>
                                        <TextBlock Text="{Binding ActiveOledScreenTitle}" FontSize="10" FontWeight="Bold" Foreground="#6C829E"/>
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Right" VerticalAlignment="Center">
                                        <TextBlock Text="128x64 PIXELS (2:1)" FontSize="9" FontWeight="Bold" Foreground="{ThemeResource SystemAccentColor}"/>
                                        <Ellipse Width="10" Height="10" Fill="#162030" Stroke="#3D506A" StrokeThickness="1.5"/>
                                    </StackPanel>
                                </Grid>

                                <!-- REAL OLED SCREEN GLASS (EXACT 2:1 ASPECT RATIO: 340px x 170px) -->
                                <Border Grid.Row="1" Background="#000000" BorderBrush="#00E5FF" BorderThickness="2" CornerRadius="4" Width="340" Height="170" Padding="12,10" HorizontalAlignment="Center">
                                    <Grid>
                                        <!-- 1. CUSTOM STUDIO CANVAS LAYOUT PREVIEW (When Custom Mode is Enabled) -->
                                        <Grid RowSpacing="6" Visibility="{Binding IsCurrentScreenCustomEnabled, Converter={StaticResource BoolToVisibilityConverter}}">
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="*"/>
                                                <RowDefinition Height="Auto"/>
                                            </Grid.RowDefinitions>

                                            <!-- Dòng 1 -->
                                            <StackPanel Grid.Row="0" Spacing="4">
                                                <TextBlock Text="{Binding EvaluatedRow1Text}" Foreground="#00E5FF" FontFamily="Consolas, Courier New, monospace" FontSize="13" FontWeight="Bold" CharacterSpacing="10"/>
                                                <Border Height="1" Background="#4400E5FF" Visibility="{Binding OledShowTopDivider, Converter={StaticResource BoolToVisibilityConverter}}"/>
                                            </StackPanel>

                                            <!-- Dòng 2 -->
                                            <TextBlock Grid.Row="1" Text="{Binding EvaluatedRow2Text}" Foreground="#FFFFFF" FontFamily="Consolas, Courier New, monospace" FontSize="12" FontWeight="SemiBold" Margin="0,2,0,0"/>

                                            <!-- Dòng 3 -->
                                            <TextBlock Grid.Row="2" Text="{Binding EvaluatedRow3Text}" Foreground="#00E5FF" FontFamily="Consolas, Courier New, monospace" FontSize="12" FontWeight="SemiBold" Margin="0,2,0,0" Visibility="{Binding IsRow3Visible, Converter={StaticResource BoolToVisibilityConverter}}"/>

                                            <!-- Dòng 4 -->
                                            <StackPanel Grid.Row="3" Spacing="4" Margin="0,2,0,0" Visibility="{Binding IsRow4Visible, Converter={StaticResource BoolToVisibilityConverter}}">
                                                <Border Height="1" Background="#4400E5FF" Visibility="{Binding OledShowBottomDivider, Converter={StaticResource BoolToVisibilityConverter}}"/>
                                                <TextBlock Text="{Binding EvaluatedRow4Text}" Foreground="#FFB74D" FontFamily="Consolas, Courier New, monospace" FontSize="11" FontWeight="Bold"/>
                                            </StackPanel>

                                            <!-- Bottom Progress Bar -->
                                            <StackPanel Grid.Row="5" Spacing="4" Visibility="{Binding OledShowPwmBar, Converter={StaticResource BoolToVisibilityConverter}}">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="*"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Grid.Column="0" Text="PWM: " Foreground="#00E5FF" FontFamily="Consolas, Courier New, monospace" FontSize="10" FontWeight="Bold"/>
                                                    <ProgressBar Grid.Column="1" Value="{Binding FanPwm}" Maximum="100" Height="5" VerticalAlignment="Center" Margin="6,0,0,0" Foreground="#00E5FF" Background="#2200E5FF"/>
                                                </Grid>
                                            </StackPanel>
                                        </Grid>

                                        <!-- 2. FIRMWARE DEFAULT LAYOUT FOR OLED 1 (1.3" SH1106/SSD1306 - updateMainDisplay) -->
                                        <Grid RowSpacing="4" Visibility="{Binding IsCurrentScreenDefaultEnabled, Converter={StaticResource BoolToVisibilityConverter}}">
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                            </Grid.RowDefinitions>

                                            <!-- Layout Screen 1 (1.3" SH1106/SSD1306) -->
                                            <StackPanel Grid.Row="0" Visibility="{Binding IsOled1TabActive, Converter={StaticResource BoolToVisibilityConverter}}" Spacing="2">
                                                <!-- Dòng 1: Fan RPM & Fan % -->
                                                <TextBlock Text="{Binding Oled1DefaultFanLine}" Foreground="#00E5FF" FontFamily="Consolas, Courier New, monospace" FontSize="12" FontWeight="Bold"/>
                                                <Border Height="1" Background="#00E5FF" Margin="0,2,0,2"/>

                                                <!-- Khung dưới: CPU, GPU, RAM (User %, Temp, Speed GHz) -->
                                                <TextBlock Text="{Binding Oled1DefaultCpuText}" Foreground="#FFFFFF" FontFamily="Consolas, Courier New, monospace" FontSize="11" FontWeight="SemiBold"/>
                                                <TextBlock Text="{Binding Oled1DefaultGpuText}" Foreground="#FFFFFF" FontFamily="Consolas, Courier New, monospace" FontSize="11" FontWeight="SemiBold"/>
                                                <TextBlock Text="{Binding Oled1DefaultRamText}" Foreground="#FFFFFF" FontFamily="Consolas, Courier New, monospace" FontSize="11" FontWeight="SemiBold"/>

                                                <Border Height="1" Background="#00E5FF" Margin="0,2,0,2"/>

                                                <!-- Dưới cùng: Thời gian hiện tại (Giờ:Phút) & Mode LED -->
                                                <TextBlock Text="{Binding Oled1DefaultTimeText}" Foreground="#FFB74D" FontFamily="Consolas, Courier New, monospace" FontSize="11" FontWeight="Bold"/>
                                            </StackPanel>

                                            <!-- Layout Screen 2 (0.96" SSD1306 Bicolor Yellow/Blue - updateSecondaryDisplay) -->
                                            <StackPanel Grid.Row="0" Spacing="4" Visibility="{Binding IsOled2TabActive, Converter={StaticResource BoolToVisibilityConverter}}">
                                                <!-- Top Yellow Header Zone (Y 0-15): Smart Fan RPM (Size 2) -->
                                                <Border Background="#1A1F2C" CornerRadius="4" Padding="6,3" Margin="0,0,0,2" BorderBrush="#FFD700" BorderThickness="1">
                                                    <Grid>
                                                        <TextBlock Text="{Binding Oled2DefaultRpmHeader}" Foreground="#FFD700" FontFamily="Consolas, Courier New, monospace" FontSize="18" FontWeight="Bold" HorizontalAlignment="Left"/>
                                                        <TextBlock Text="[YELLOW ZONE]" Foreground="#FFD700" FontSize="9" Opacity="0.7" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                                    </Grid>
                                                </Border>

                                                <!-- Blue Content Zone (Y 16-63) -->
                                                <StackPanel Spacing="6" Margin="0,2,0,0">
                                                    <!-- CPU Line (Y=20) -->
                                                    <TextBlock Text="{Binding Oled2DefaultCpuText}" Foreground="#00E5FF" FontFamily="Consolas, Courier New, monospace" FontSize="12" FontWeight="SemiBold"/>
                                                    
                                                    <!-- GPU Line (Y=36) -->
                                                    <TextBlock Text="{Binding Oled2DefaultGpuText}" Foreground="#00E5FF" FontFamily="Consolas, Courier New, monospace" FontSize="12" FontWeight="SemiBold"/>

                                                    <!-- PWM & Transport Line (Y=52) -->
                                                    <Grid Margin="0,4,0,0">
                                                        <TextBlock Text="{Binding Oled2DefaultPwmText}" Foreground="#00E5FF" FontFamily="Consolas, Courier New, monospace" FontSize="11" FontWeight="Bold"/>
                                                        <TextBlock Text="{Binding Oled2DefaultTransportText}" Foreground="#4CAF50" FontFamily="Consolas, Courier New, monospace" FontSize="11" FontWeight="Bold" HorizontalAlignment="Right"/>
                                                    </Grid>
                                                </StackPanel>
                                            </StackPanel>
                                        </Grid>
                                    </Grid>
                                </Border>

                                <!-- Bottom PCB Pin Headers (GND VCC SCL SDA) & Screw Holes -->
                                <Grid Grid.Row="2" Margin="0,8,0,0">
                                    <StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Left" VerticalAlignment="Center">
                                        <Ellipse Width="10" Height="10" Fill="#162030" Stroke="#3D506A" StrokeThickness="1.5"/>
                                    </StackPanel>

                                    <!-- Gold Pin Headers -->
                                    <StackPanel Orientation="Horizontal" Spacing="14" HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <StackPanel Orientation="Horizontal" Spacing="3">
                                            <Rectangle Width="5" Height="5" Fill="#FFC107" RadiusX="1" RadiusY="1"/>
                                            <TextBlock Text="GND" FontSize="9" FontWeight="Bold" Foreground="#78909C"/>
                                        </StackPanel>
                                        <StackPanel Orientation="Horizontal" Spacing="3">
                                            <Rectangle Width="5" Height="5" Fill="#FFC107" RadiusX="1" RadiusY="1"/>
                                            <TextBlock Text="VCC" FontSize="9" FontWeight="Bold" Foreground="#EF5350"/>
                                        </StackPanel>
                                        <StackPanel Orientation="Horizontal" Spacing="3">
                                            <Rectangle Width="5" Height="5" Fill="#FFC107" RadiusX="1" RadiusY="1"/>
                                            <TextBlock Text="SCL" FontSize="9" FontWeight="Bold" Foreground="#42A5F5"/>
                                        </StackPanel>
                                        <StackPanel Orientation="Horizontal" Spacing="3">
                                            <Rectangle Width="5" Height="5" Fill="#FFC107" RadiusX="1" RadiusY="1"/>
                                            <TextBlock Text="SDA" FontSize="9" FontWeight="Bold" Foreground="#66BB6A"/>
                                        </StackPanel>
                                    </StackPanel>

                                    <StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Right" VerticalAlignment="Center">
                                        <Ellipse Width="10" Height="10" Fill="#162030" Stroke="#3D506A" StrokeThickness="1.5"/>
                                    </StackPanel>
                                </Grid>
                            </Grid>
                        </Border>

                        <!-- Layout Structure Options -->
                        <Border Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}" CornerRadius="8" Padding="14">
                            <StackPanel Spacing="12">
                                <TextBlock Text="CẤU TRÚC BỐ CỤC MÀN HÌNH" FontWeight="Bold" FontSize="12"/>
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <TextBlock Text="Số dòng hiển thị:" VerticalAlignment="Center" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                    <ToggleButton Content="2 Dòng (Chữ to)" IsChecked="{Binding IsRowCount2, Mode=OneWay}" Command="{Binding SetOledRowCountCommand}" CommandParameter="2"/>
                                    <ToggleButton Content="3 Dòng (Vừa)" IsChecked="{Binding IsRowCount3, Mode=OneWay}" Command="{Binding SetOledRowCountCommand}" CommandParameter="3"/>
                                    <ToggleButton Content="4 Dòng (Chi tiết)" IsChecked="{Binding IsRowCount4, Mode=OneWay}" Command="{Binding SetOledRowCountCommand}" CommandParameter="4"/>
                                </StackPanel>

                                <StackPanel Orientation="Horizontal" Spacing="16">
                                    <CheckBox Content="Đường phân cách trên" IsChecked="{Binding OledShowTopDivider, Mode=TwoWay}"/>
                                    <CheckBox Content="Đường phân cách dưới" IsChecked="{Binding OledShowBottomDivider, Mode=TwoWay}"/>
                                    <CheckBox Content="Thanh Bar PWM %" IsChecked="{Binding OledShowPwmBar, Mode=TwoWay}"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- RIGHT COLUMN: INTERACTIVE TELEMETRY WIDGET SLOT ASSIGNMENT -->
                    <StackPanel Grid.Column="1" Spacing="16">
                        <TextBlock Text="GÁN THÔNG SỐ VÀO TỪNG DÒNG (TELEMETRY WIDGET ASSIGNMENT)" FontWeight="Bold" FontSize="13"/>
                        
                        <!-- Row 1 Selector -->
                        <StackPanel Spacing="4">
                            <TextBlock Text="DÒNG 1 (HEADER / VỊ TRÍ TRÊN CÙNG):" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontWeight="Bold"/>
                            <ComboBox SelectedValue="{Binding OledRow1Widget, Mode=TwoWay}" SelectedValuePath="Tag" HorizontalAlignment="Stretch">
                                <ComboBoxItem Tag="HEADER_TITLE">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <FontIcon Glyph="&#xE718;" Foreground="#00E5FF" FontSize="13"/>
                                        <TextBlock Text="Tiêu đề Custom (LLANO SMART FAN)"/>
                                    </StackPanel>
                                </ComboBoxItem>
                                <ComboBoxItem Tag="CPU_TELEMETRY">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <FontIcon Glyph="&#xE9D9;" Foreground="#00BCD4" FontSize="13"/>
                                        <TextBlock Text="CPU Processor (Nhiệt độ &amp; Mức tải)"/>
                                    </StackPanel>
                                </ComboBoxItem>
                                <ComboBoxItem Tag="GPU_TELEMETRY">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <FontIcon Glyph="&#xE9E9;" Foreground="#FF9800" FontSize="13"/>
                                        <TextBlock Text="GPU Graphics (Nhiệt độ &amp; Mức tải)"/>
                                    </StackPanel>
                                </ComboBoxItem>
                                <ComboBoxItem Tag="FAN_TELEMETRY">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <FontIcon Glyph="&#xE9E0;" Foreground="#4CAF50" FontSize="13"/>
                                        <TextBlock Text="Tốc độ Quạt (RPM)"/>
                                    </StackPanel>
                                </ComboBoxItem>
                                <ComboBoxItem Tag="POWER_TELEMETRY">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <FontIcon Glyph="&#xE945;" Foreground="#FFEB3B" FontSize="13"/>
                                        <TextBlock Text="Công suất Watt (CPU / GPU)"/>
                                    </StackPanel>
                                </ComboBoxItem>
                            </ComboBox>
                        </StackPanel>

                        <!-- Row 2 Selector -->
                        <StackPanel Spacing="4">
                            <TextBlock Text="DÒNG 2 (THÔNG SỐ CHÍNH):" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontWeight="Bold"/>
                            <ComboBox SelectedValue="{Binding OledRow2Widget, Mode=TwoWay}" SelectedValuePath="Tag" HorizontalAlignment="Stretch">
                                <ComboBoxItem Tag="CPU_TELEMETRY">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <FontIcon Glyph="&#xE9D9;" Foreground="#00BCD4" FontSize="13"/>
                                        <TextBlock Text="CPU Processor (Nhiệt độ &amp; Mức tải)"/>
                                    </StackPanel>
                                </ComboBoxItem>
                                <ComboBoxItem Tag="GPU_TELEMETRY">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <FontIcon Glyph="&#xE9E9;" Foreground="#FF9800" FontSize="13"/>
                                        <TextBlock Text="GPU Graphics (Nhiệt độ &amp; Mức tải)"/>
                                    </StackPanel>
                                </ComboBoxItem>
                                <ComboBoxItem Tag="FAN_TELEMETRY">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <FontIcon Glyph="&#xE9E0;" Foreground="#4CAF50" FontSize="13"/>
                                        <TextBlock Text="Tốc độ Quạt (RPM)"/>
                                    </StackPanel>
                                </ComboBoxItem>
                                <ComboBoxItem Tag="RAM_TELEMETRY">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <FontIcon Glyph="&#xE8B9;" Foreground="#E91E63" FontSize="13"/>
                                        <TextBlock Text="Bộ nhớ RAM System"/>
                                    </StackPanel>
                                </ComboBoxItem>
                                <ComboBoxItem Tag="CLOCK_TELEMETRY">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <FontIcon Glyph="&#xE916;" Foreground="#9C27B0" FontSize="13"/>
                                        <TextBlock Text="Xung nhịp Clock (GHz / MHz)"/>
                                    </StackPanel>
                                </ComboBoxItem>
                            </ComboBox>
                        </StackPanel>

                        <!-- Row 3 Selector -->
                        <StackPanel Spacing="4">
                            <TextBlock Text="DÒNG 3 (THÔNG SỐ PHỤ):" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontWeight="Bold"/>
                            <ComboBox SelectedValue="{Binding OledRow3Widget, Mode=TwoWay}" SelectedValuePath="Tag" HorizontalAlignment="Stretch">
                                <ComboBoxItem Tag="GPU_TELEMETRY">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <FontIcon Glyph="&#xE9E9;" Foreground="#FF9800" FontSize="13"/>
                                        <TextBlock Text="GPU Graphics (Nhiệt độ &amp; Mức tải)"/>
                                    </StackPanel>
                                </ComboBoxItem>
                                <ComboBoxItem Tag="CPU_TELEMETRY">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <FontIcon Glyph="&#xE9D9;" Foreground="#00BCD4" FontSize="13"/>
                                        <TextBlock Text="CPU Processor (Nhiệt độ &amp; Mức tải)"/>
                                    </StackPanel>
                                </ComboBoxItem>
                                <ComboBoxItem Tag="FAN_TELEMETRY">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <FontIcon Glyph="&#xE9E0;" Foreground="#4CAF50" FontSize="13"/>
                                        <TextBlock Text="Tốc độ Quạt (RPM)"/>
                                    </StackPanel>
                                </ComboBoxItem>
                                <ComboBoxItem Tag="RAM_TELEMETRY">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <FontIcon Glyph="&#xE8B9;" Foreground="#E91E63" FontSize="13"/>
                                        <TextBlock Text="Bộ nhớ RAM System"/>
                                    </StackPanel>
                                </ComboBoxItem>
                                <ComboBoxItem Tag="POWER_TELEMETRY">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <FontIcon Glyph="&#xE945;" Foreground="#FFEB3B" FontSize="13"/>
                                        <TextBlock Text="Công suất Watt (CPU / GPU)"/>
                                    </StackPanel>
                                </ComboBoxItem>
                            </ComboBox>
                        </StackPanel>

                        <!-- Row 4 Selector -->
                        <StackPanel Spacing="4">
                            <TextBlock Text="DÒNG 4 (TRẠNG THÁI ĐÁY / FOOTER):" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontWeight="Bold"/>
                            <ComboBox SelectedValue="{Binding OledRow4Widget, Mode=TwoWay}" SelectedValuePath="Tag" HorizontalAlignment="Stretch">
                                <ComboBoxItem Tag="FAN_TELEMETRY">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <FontIcon Glyph="&#xE9E0;" Foreground="#4CAF50" FontSize="13"/>
                                        <TextBlock Text="Tốc độ Quạt (RPM)"/>
                                    </StackPanel>
                                </ComboBoxItem>
                                <ComboBoxItem Tag="PWM_PCT">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <FontIcon Glyph="&#xE780;" Foreground="#FFC107" FontSize="13"/>
                                        <TextBlock Text="Tỷ lệ PWM %"/>
                                    </StackPanel>
                                </ComboBoxItem>
                                <ComboBoxItem Tag="RAM_TELEMETRY">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <FontIcon Glyph="&#xE8B9;" Foreground="#E91E63" FontSize="13"/>
                                        <TextBlock Text="Bộ nhớ RAM System"/>
                                    </StackPanel>
                                </ComboBoxItem>
                                <ComboBoxItem Tag="TIME_TELEMETRY">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <FontIcon Glyph="&#xE815;" Foreground="#FFB74D" FontSize="13"/>
                                        <TextBlock Text="Thời gian hệ thống (Giờ:Phút)"/>
                                    </StackPanel>
                                </ComboBoxItem>
                                <ComboBoxItem Tag="HEADER_TITLE">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <FontIcon Glyph="&#xE718;" Foreground="#00E5FF" FontSize="13"/>
                                        <TextBlock Text="Tiêu đề Custom (LLANO SMART FAN)"/>
                                    </StackPanel>
                                </ComboBoxItem>
                            </ComboBox>
                        </StackPanel>

                        <!-- Granular Sub-Metric Checkboxes -->
                        <Border Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}" CornerRadius="8" Padding="12">
                            <StackPanel Spacing="10">
                                <TextBlock Text="TÙY CHỌN TÍCH CHỌN THÀNH PHẦN HIỂN THỊ:" FontWeight="Bold" FontSize="11"/>
                                
                                <!-- CPU Metrics Toggles -->
                                <StackPanel Spacing="4">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <FontIcon Glyph="&#xE9D9;" Foreground="#00E5FF" FontSize="12"/>
                                        <TextBlock Text="Thành phần Dòng CPU:" FontSize="10" Foreground="#00E5FF" FontWeight="Bold"/>
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" Spacing="12">
                                        <CheckBox Content="Nhiệt độ (°C)" IsChecked="{Binding OledShowCpuTemp, Mode=TwoWay}"/>
                                        <CheckBox Content="Usage (%)" IsChecked="{Binding OledShowCpuUsage, Mode=TwoWay}"/>
                                        <CheckBox Content="Clock (GHz)" IsChecked="{Binding OledShowCpuClock, Mode=TwoWay}"/>
                                        <CheckBox Content="Power (W)" IsChecked="{Binding OledShowCpuPower, Mode=TwoWay}"/>
                                    </StackPanel>
                                </StackPanel>

                                <!-- GPU Metrics Toggles -->
                                <StackPanel Spacing="4">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <FontIcon Glyph="&#xE9E9;" Foreground="#FF9800" FontSize="12"/>
                                        <TextBlock Text="Thành phần Dòng GPU:" FontSize="10" Foreground="#FF9800" FontWeight="Bold"/>
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" Spacing="12">
                                        <CheckBox Content="Nhiệt độ (°C)" IsChecked="{Binding OledShowGpuTemp, Mode=TwoWay}"/>
                                        <CheckBox Content="Usage (%)" IsChecked="{Binding OledShowGpuUsage, Mode=TwoWay}"/>
                                        <CheckBox Content="Clock (MHz)" IsChecked="{Binding OledShowGpuClock, Mode=TwoWay}"/>
                                        <CheckBox Content="Power (W)" IsChecked="{Binding OledShowGpuPower, Mode=TwoWay}"/>
                                    </StackPanel>
                                </StackPanel>

                                <!-- Smart Fan / RAM Toggles -->
                                <StackPanel Spacing="4">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <FontIcon Glyph="&#xE9E0;" Foreground="#4CAF50" FontSize="12"/>
                                        <TextBlock Text="Thành phần Quạt &amp; Hệ Thống:" FontSize="10" Foreground="#4CAF50" FontWeight="Bold"/>
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" Spacing="12">
                                        <CheckBox Content="Smart Fan RPM" IsChecked="{Binding OledShowSmartFanRpm, Mode=TwoWay}"/>
                                        <CheckBox Content="PWM %" IsChecked="{Binding OledShowSmartFanPwm, Mode=TwoWay}"/>
                                        <CheckBox Content="RAM GB" IsChecked="{Binding OledShowRamUsage, Mode=TwoWay}"/>
                                    </StackPanel>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <!-- Custom Text Input Override -->
                        <TextBox Header="Văn Bản Tiêu Đề Tùy Chỉnh (Custom Title Text)" Text="{Binding Oled1CustomTitle, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>

                        <!-- Action Buttons -->
                        <StackPanel Orientation="Horizontal" Spacing="12" Margin="0,8,0,0">
                            <Button Command="{Binding SendCurrentOledFrameToEsp32Command}" Style="{StaticResource AccentButtonStyle}">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <FontIcon Glyph="&#xE896;" FontSize="14"/>
                                    <TextBlock Text="Render &amp; Nạp Sang ESP32-S3 Ngay" FontWeight="Bold"/>
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </StackPanel>
                </Grid>
            </StackPanel>
        </Border>
