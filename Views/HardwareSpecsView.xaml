<UserControl
    x:Class="SmartFanCooling.Views.HardwareSpecsView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:converters="using:SmartFanCooling.Converters">

    <UserControl.Resources>
        <converters:FloatFormatConverter x:Key="FloatFormatConverter"/>
    </UserControl.Resources>

    <StackPanel Spacing="18">
        <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" CornerRadius="10" Padding="16">
            <StackPanel Spacing="14">
                <TextBlock Text="Thông Số Cảm Biến Phần CỨng Chi Tiết" FontSize="16" FontWeight="Bold"/>
                <Grid RowSpacing="10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Grid.Column="0" Text="Nhiệt Độ CPU Package:" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                    <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding CpuTemp, Converter={StaticResource FloatFormatConverter}, ConverterParameter='{}{0:F0} °C'}" FontWeight="Bold"/>

                    <TextBlock Grid.Row="1" Grid.Column="0" Text="Nhiệt Độ GPU Core:" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                    <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding GpuTemp, Converter={StaticResource FloatFormatConverter}, ConverterParameter='{}{0:F0} °C'}" FontWeight="Bold"/>

                    <TextBlock Grid.Row="2" Grid.Column="0" Text="RAM Hệ Thống Đã Dùng:" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                    <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding RamStatusText}" FontWeight="Bold"/>

                    <TextBlock Grid.Row="3" Grid.Column="0" Text="Nhiệt Độ Bo Mạch Chủ:" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                    <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding MotherboardTemp, Converter={StaticResource FloatFormatConverter}, ConverterParameter='{}{0:F0} °C'}" FontWeight="Bold"/>
                </Grid>
            </StackPanel>
        </Border>
    </StackPanel>
</UserControl>
