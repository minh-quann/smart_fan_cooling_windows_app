<UserControl
    x:Class="SmartFanCooling.Views.FanControl.FanCurveView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <StackPanel Spacing="18">
        <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" CornerRadius="10" Padding="16">
            <StackPanel Spacing="14">
                <TextBlock Text="Thiết Lập Đường Cong Nhiệt Độ (Fan Curve Editor)" FontSize="16" FontWeight="Bold"/>
                <TextBlock Text="Tùy chỉnh phần trăm PWM của quạt ứng với các mốc nhiệt độ CPU/GPU (°C)." Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                
                 <!-- 2D FAN CURVE CHART DISPLAY (ARMOURY CRATE & MSI AFTERBURNER STYLE) -->
                 <Border Background="{StaticResource Gray950Brush}" BorderBrush="{StaticResource Gray700Brush}" BorderThickness="1" CornerRadius="10" Padding="16,14" Margin="0,4,0,10">
                     <Grid>
                         <Grid.RowDefinitions>
                             <RowDefinition Height="Auto"/>
                             <RowDefinition Height="210"/>
                             <RowDefinition Height="Auto"/>
                         </Grid.RowDefinitions>
                         
                         <!-- Header -->
                         <StackPanel Grid.Row="0" Orientation="Horizontal" HorizontalAlignment="Stretch" Margin="0,0,0,10">
                             <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                 <FontIcon Glyph="&#xE9D2;" Foreground="{ThemeResource SystemAccentColor}" FontSize="14"/>
                                 <TextBlock Text="BIỂU ĐỒ ĐƯỜNG CONG TỐC ĐỘ QUẠT (KÉO TRỰC TIẾP TRÊN NÚT NỐI)" FontWeight="Bold" FontSize="13"/>
                             </StackPanel>
                         </StackPanel>

                         <!-- 2D Canvas Chart Box -->
                         <Grid Grid.Row="1" Margin="34,0,16,0">
                             <Canvas x:Name="FanCurveCanvas" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Background="Transparent"
                                     SizeChanged="FanCurveCanvas_SizeChanged"
                                     PointerPressed="FanCurveCanvas_PointerPressed"
                                     PointerMoved="FanCurveCanvas_PointerMoved"
                                     PointerReleased="FanCurveCanvas_PointerReleased"
                                     PointerCanceled="FanCurveCanvas_PointerReleased">
                                 <!-- Grid Horizontal Lines -->
                                 <Line x:Name="GridH_100" X1="0" Y1="15" X2="600" Y2="15" Stroke="{StaticResource Gray700Brush}" StrokeDashArray="3 3" StrokeThickness="1"/>
                                 <Line x:Name="GridH_75"  X1="0" Y1="57" X2="600" Y2="57" Stroke="{StaticResource Gray700Brush}" StrokeDashArray="3 3" StrokeThickness="1"/>
                                 <Line x:Name="GridH_50"  X1="0" Y1="100" X2="600" Y2="100" Stroke="{StaticResource Gray700Brush}" StrokeDashArray="3 3" StrokeThickness="1"/>
                                 <Line x:Name="GridH_25"  X1="0" Y1="142" X2="600" Y2="142" Stroke="{StaticResource Gray700Brush}" StrokeDashArray="3 3" StrokeThickness="1"/>
                                 <Line x:Name="GridH_0"   X1="0" Y1="185" X2="600" Y2="185" Stroke="{StaticResource Gray700Brush}" StrokeThickness="1"/>

                                 <!-- Y-Axis Labels -->
                                 <TextBlock Text="100%" Canvas.Left="-34" Canvas.Top="7" FontSize="10" Foreground="{StaticResource Gray300Brush}"/>
                                 <TextBlock Text="75%"  Canvas.Left="-28" Canvas.Top="49" FontSize="10" Foreground="{StaticResource Gray300Brush}"/>
                                 <TextBlock Text="50%"  Canvas.Left="-28" Canvas.Top="92" FontSize="10" Foreground="{StaticResource Gray300Brush}"/>
                                 <TextBlock Text="25%"  Canvas.Left="-28" Canvas.Top="134" FontSize="10" Foreground="{StaticResource Gray300Brush}"/>
                                 <TextBlock Text="0%"   Canvas.Left="-22" Canvas.Top="177" FontSize="10" Foreground="{StaticResource Gray300Brush}"/>

                                 <!-- Grid Vertical Lines -->
                                 <Line x:Name="GridV_30" Y1="15" Y2="185" Stroke="{StaticResource Gray700Brush}" StrokeDashArray="3 3" StrokeThickness="1"/>
                                 <Line x:Name="GridV_40" Y1="15" Y2="185" Stroke="{StaticResource Gray700Brush}" StrokeDashArray="3 3" StrokeThickness="1"/>
                                 <Line x:Name="GridV_50" Y1="15" Y2="185" Stroke="{StaticResource Gray700Brush}" StrokeDashArray="3 3" StrokeThickness="1"/>
                                 <Line x:Name="GridV_60" Y1="15" Y2="185" Stroke="{StaticResource Gray700Brush}" StrokeDashArray="3 3" StrokeThickness="1"/>
                                 <Line x:Name="GridV_70" Y1="15" Y2="185" Stroke="{StaticResource Gray700Brush}" StrokeDashArray="3 3" StrokeThickness="1"/>
                                 <Line x:Name="GridV_80" Y1="15" Y2="185" Stroke="{StaticResource Gray700Brush}" StrokeDashArray="3 3" StrokeThickness="1"/>
                                 <Line x:Name="GridV_90" Y1="15" Y2="185" Stroke="{StaticResource Gray700Brush}" StrokeDashArray="3 3" StrokeThickness="1"/>

                                 <!-- Area Fill Under Curve -->
                                 <Polygon x:Name="CurvePolygonFill" Fill="{ThemeResource SystemAccentColor}" Opacity="0.15"/>

                                 <!-- Pure White Polyline Curve (Armoury Crate Style) -->
                                 <Polyline x:Name="CurvePolyline" Stroke="White" StrokeThickness="2.5" StrokeLineJoin="Round"/>

                                 <!-- 7 Solid White Square Handles (Armoury Crate Nodes) -->
                                 <Rectangle x:Name="NodeRect_30" Width="10" Height="10" Fill="White" Stroke="{StaticResource Gray950Brush}" StrokeThickness="1" Canvas.Left="0" Canvas.Top="0"/>
                                 <Rectangle x:Name="NodeRect_40" Width="10" Height="10" Fill="White" Stroke="{StaticResource Gray950Brush}" StrokeThickness="1" Canvas.Left="0" Canvas.Top="0"/>
                                 <Rectangle x:Name="NodeRect_50" Width="10" Height="10" Fill="White" Stroke="{StaticResource Gray950Brush}" StrokeThickness="1" Canvas.Left="0" Canvas.Top="0"/>
                                 <Rectangle x:Name="NodeRect_60" Width="10" Height="10" Fill="White" Stroke="{StaticResource Gray950Brush}" StrokeThickness="1" Canvas.Left="0" Canvas.Top="0"/>
                                 <Rectangle x:Name="NodeRect_70" Width="10" Height="10" Fill="White" Stroke="{StaticResource Gray950Brush}" StrokeThickness="1" Canvas.Left="0" Canvas.Top="0"/>
                                 <Rectangle x:Name="NodeRect_80" Width="10" Height="10" Fill="White" Stroke="{StaticResource Gray950Brush}" StrokeThickness="1" Canvas.Left="0" Canvas.Top="0"/>
                                 <Rectangle x:Name="NodeRect_90" Width="10" Height="10" Fill="White" Stroke="{StaticResource Gray950Brush}" StrokeThickness="1" Canvas.Left="0" Canvas.Top="0"/>

                                 <!-- X-Axis Temperature Labels (100% Perfectly Aligned to Vertical Grid Lines) -->
                                 <TextBlock x:Name="TxtLabel_30" Text="30°C" Canvas.Top="192" FontSize="11" Foreground="{StaticResource Gray300Brush}"/>
                                 <TextBlock x:Name="TxtLabel_40" Text="40°C" Canvas.Top="192" FontSize="11" Foreground="{StaticResource Gray300Brush}"/>
                                 <TextBlock x:Name="TxtLabel_50" Text="50°C" Canvas.Top="192" FontSize="11" Foreground="{StaticResource Gray300Brush}"/>
                                 <TextBlock x:Name="TxtLabel_60" Text="60°C" Canvas.Top="192" FontSize="11" Foreground="{StaticResource Gray300Brush}"/>
                                 <TextBlock x:Name="TxtLabel_70" Text="70°C" Canvas.Top="192" FontSize="11" Foreground="{StaticResource Gray300Brush}"/>
                                 <TextBlock x:Name="TxtLabel_80" Text="80°C" Canvas.Top="192" FontSize="11" Foreground="{StaticResource Gray300Brush}"/>
                                 <TextBlock x:Name="TxtLabel_90" Text="90°C" Canvas.Top="192" FontSize="11" Foreground="{StaticResource Gray300Brush}"/>
                             </Canvas>
                         </Grid>
                     </Grid>
                 </Border>
                
                <!-- Curve Sliders -->
                <Grid Margin="0,6,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Grid.Column="0" Text="Mốc 30 °C:" VerticalAlignment="Center" Width="80"/>
                    <Slider Grid.Row="0" Grid.Column="1" Minimum="0" Maximum="100" Value="{Binding CurveP30, Mode=TwoWay}"/>
                    
                    <TextBlock Grid.Row="1" Grid.Column="0" Text="Mốc 40 °C:" VerticalAlignment="Center"/>
                    <Slider Grid.Row="1" Grid.Column="1" Minimum="0" Maximum="100" Value="{Binding CurveP40, Mode=TwoWay}"/>

                    <TextBlock Grid.Row="2" Grid.Column="0" Text="Mốc 50 °C:" VerticalAlignment="Center"/>
                    <Slider Grid.Row="2" Grid.Column="1" Minimum="0" Maximum="100" Value="{Binding CurveP50, Mode=TwoWay}"/>

                    <TextBlock Grid.Row="3" Grid.Column="0" Text="Mốc 60 °C:" VerticalAlignment="Center"/>
                    <Slider Grid.Row="3" Grid.Column="1" Minimum="0" Maximum="100" Value="{Binding CurveP60, Mode=TwoWay}"/>

                    <TextBlock Grid.Row="4" Grid.Column="0" Text="Mốc 70 °C:" VerticalAlignment="Center"/>
                    <Slider Grid.Row="4" Grid.Column="1" Minimum="0" Maximum="100" Value="{Binding CurveP70, Mode=TwoWay}"/>

                    <TextBlock Grid.Row="5" Grid.Column="0" Text="Mốc 80 °C:" VerticalAlignment="Center"/>
                    <Slider Grid.Row="5" Grid.Column="1" Minimum="0" Maximum="100" Value="{Binding CurveP80, Mode=TwoWay}"/>

                    <TextBlock Grid.Row="6" Grid.Column="0" Text="Mốc 90 °C:" VerticalAlignment="Center"/>
                    <Slider Grid.Row="6" Grid.Column="1" Minimum="0" Maximum="100" Value="{Binding CurveP90, Mode=TwoWay}"/>
                </Grid>
            </StackPanel>
        </Border>
    </StackPanel>
</UserControl>
