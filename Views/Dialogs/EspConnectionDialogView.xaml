<UserControl
    x:Class="SmartFanCooling.Views.Dialogs.EspConnectionDialogView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:converters="using:SmartFanCooling.Converters">

    <UserControl.Resources>
        <converters:IntToVisibilityConverter x:Key="IntToVisibilityConverter"/>
        <converters:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter"/>
    </UserControl.Resources>

    <Grid Visibility="{Binding IsEspConnectionDialogOpen, Converter={StaticResource BoolToVisibilityConverter}}"
          Background="#D0000000" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
        <Border Background="#161820" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1"
                CornerRadius="14" Width="680" Height="530" HorizontalAlignment="Center" VerticalAlignment="Center" Padding="20">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Header -->
                <Grid Grid.Row="0" Margin="0,0,0,14">
                    <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                        <FontIcon Glyph="&#xE702;" Foreground="{ThemeResource SystemAccentColor}" FontSize="22"/>
                        <StackPanel>
                            <TextBlock Text="KẾT NỐI &amp; CẤU HÌNH WI-FI CHO ESP32-S3" FontWeight="Bold" FontSize="16"/>
                            <TextBlock Text="Quét kết nối Bluetooth BLE hoặc nạp SSID/Password Wi-Fi cho quạt làm mát." FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                        </StackPanel>
                    </StackPanel>
                    <Button Command="{Binding CloseEspConnectionDialogCommand}" HorizontalAlignment="Right" VerticalAlignment="Top" Padding="8,4">
                        <FontIcon Glyph="&#xE711;" FontSize="12"/>
                    </Button>
                </Grid>

                <!-- Dialog Segmented Tabs -->
                <Grid Grid.Row="1" Margin="0,0,0,14">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Button Grid.Column="0" Command="{Binding OpenEspConnectionDialogCommand}" CommandParameter="0" HorizontalAlignment="Stretch" Margin="0,0,4,0">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon Glyph="&#xE702;" Foreground="#00BCD4" FontSize="13"/>
                            <TextBlock Text="Quét Bluetooth BLE" FontWeight="Bold"/>
                        </StackPanel>
                    </Button>
                    <Button Grid.Column="1" Command="{Binding OpenEspConnectionDialogCommand}" CommandParameter="1" HorizontalAlignment="Stretch" Margin="2,0,2,0">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon Glyph="&#xE701;" Foreground="#FF9800" FontSize="13"/>
                            <TextBlock Text="Cấu Hình Wi-Fi (SSID)" FontWeight="Bold"/>
                        </StackPanel>
                    </Button>
                    <Button Grid.Column="2" Command="{Binding OpenEspConnectionDialogCommand}" CommandParameter="2" HorizontalAlignment="Stretch" Margin="4,0,0,0">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon Glyph="&#xE839;" Foreground="#4CAF50" FontSize="13"/>
                            <TextBlock Text="IP Wi-Fi Trực Tiếp" FontWeight="Bold"/>
                        </StackPanel>
                    </Button>
                </Grid>

                <!-- Body Content -->
                <Grid Grid.Row="2">
                    <!-- TAB 0: REAL CONTINUOUS BLE SCAN & CONNECT -->
                    <StackPanel Visibility="{Binding EspDialogSelectedTab, Converter={StaticResource IntToVisibilityConverter}, ConverterParameter=0}" Spacing="12">
                        <Grid>
                            <TextBlock Text="{Binding BleConnectionStatus}" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center"/>
                            <Border HorizontalAlignment="Right" Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}" CornerRadius="6" Padding="10,5">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <ProgressRing IsActive="{Binding IsScanningBle}" Width="14" Height="14"/>
                                    <TextBlock Text="Đang Quét Liên Tục (Real-Time)" FontSize="11" FontWeight="Bold" Foreground="{ThemeResource SystemAccentColor}"/>
                                </StackPanel>
                            </Border>
                        </Grid>

                        <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8" Height="280">
                            <ItemsControl ItemsSource="{Binding ScannedBleDevices}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="0,0,0,1" Padding="12,10">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <FontIcon Glyph="&#xE702;" Foreground="#00BCD4" FontSize="20" Margin="0,0,12,0" VerticalAlignment="Center"/>
                                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding Name}" FontWeight="Bold" FontSize="14"/>
                                                    <TextBlock Text="{Binding MacAddress}" FontSize="10" Foreground="#8A92A6"/>
                                                </StackPanel>
                                                <TextBlock Grid.Column="2" Text="{Binding SignalText}" FontSize="11" Foreground="#4CAF50" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,16,0"/>
                                                <Button Grid.Column="3" Content="Kết Nối BLE" Click="BleDeviceBtn_Click" Tag="{Binding}" Style="{ThemeResource AccentButtonStyle}" Padding="12,5"/>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </Border>
                    </StackPanel>

                    <!-- TAB 1: WI-FI PROVISIONING (NẠP SSID/PASSWORD CHO ESP32) -->
                    <StackPanel Visibility="{Binding EspDialogSelectedTab, Converter={StaticResource IntToVisibilityConverter}, ConverterParameter=1}" Spacing="14">
                        <TextBlock Text="Nạp Cấu Hình Wi-Fi Vào Chip ESP32-S3" FontWeight="Bold" FontSize="14"/>
                        <TextBlock Text="ESP32 sẽ nhận Tên Mạng và Mật Khẩu Wi-Fi này để tự động kết nối vào Router nhà anh." FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>

                        <Border Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}" CornerRadius="10" Padding="16" Margin="0,4">
                            <StackPanel Spacing="12">
                                <TextBlock Text="Tên Mạng Wi-Fi (SSID):" FontSize="12" FontWeight="SemiBold"/>
                                <TextBox Text="{Binding WifiSsid, Mode=TwoWay}" PlaceholderText="Ví dụ: MyHomeWiFi_5G"/>

                                <TextBlock Text="Mật Khẩu Wi-Fi (Password):" FontSize="12" FontWeight="SemiBold"/>
                                <TextBox Text="{Binding WifiPassword, Mode=TwoWay}" PlaceholderText="Nhập mật khẩu Wi-Fi"/>

                                <Button Command="{Binding SendWifiProvisioningCommand}" Style="{ThemeResource AccentButtonStyle}" HorizontalAlignment="Stretch" Padding="12,8" Margin="0,6,0,0">
                                    <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center">
                                        <FontIcon Glyph="&#xE701;" FontSize="14"/>
                                        <TextBlock Text="GỬI CẤU HÌNH WI-FI SANG ESP32-S3" FontWeight="Bold"/>
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </Border>
                        <TextBlock Text="{Binding WifiProvisionStatus}" FontSize="11" Foreground="{ThemeResource SystemAccentColor}" FontWeight="SemiBold"/>
                    </StackPanel>

                    <!-- TAB 2: WI-FI IP DIRECT -->
                    <StackPanel Visibility="{Binding EspDialogSelectedTab, Converter={StaticResource IntToVisibilityConverter}, ConverterParameter=2}" Spacing="14">
                        <TextBlock Text="Kết Nối Trực Tiếp Qua Địa Chỉ IP Wi-Fi" FontWeight="Bold" FontSize="14"/>
                        <TextBlock Text="Khi ESP32 đã vào Wi-Fi, anh chỉ cần nhập địa chỉ IP của quạt để điều khiển qua mạng LAN." FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>

                        <Border Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}" CornerRadius="10" Padding="16" Margin="0,4">
                            <StackPanel Spacing="12">
                                <TextBlock Text="Địa Chỉ IP Mạng Wi-Fi ESP32:" FontSize="12" FontWeight="SemiBold"/>
                                <TextBox Text="{Binding WifiIpAddress, Mode=TwoWay}" PlaceholderText="192.168.1.100 hoặc smartfan.local"/>

                                <Button Command="{Binding ConnectWifiIpDirectCommand}" Style="{ThemeResource AccentButtonStyle}" HorizontalAlignment="Stretch" Padding="12,8" Margin="0,6,0,0">
                                    <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center">
                                        <FontIcon Glyph="&#xE839;" FontSize="14"/>
                                        <TextBlock Text="KẾT NỐI QUA WI-FI IP" FontWeight="Bold"/>
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Grid>

                <!-- Footer -->
                <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="10" Margin="0,14,0,0">
                    <Button Command="{Binding CloseEspConnectionDialogCommand}" Content="Đóng" Padding="16,6"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>
