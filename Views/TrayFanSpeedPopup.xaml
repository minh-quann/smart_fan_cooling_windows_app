<Window
    x:Class="SmartFanCooling.Views.TrayFanSpeedPopup"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="">

    <!-- Borderless popup with fan speed slider for tray icon right-click -->
    <Grid RequestedTheme="Dark"
          Background="{ThemeResource SolidBackgroundFillColorBaseBrush}"
          Padding="20,14,20,12">
        <StackPanel Spacing="4">
            <!-- Title row with close button -->
            <Grid>
                <TextBlock Text="🌀 Tốc độ quạt"
                           FontSize="12"
                           VerticalAlignment="Center"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                <Button Content="&#xE711;" 
                        FontFamily="Segoe MDL2 Assets" FontSize="10"
                        Click="Close_Click"
                        HorizontalAlignment="Right"
                        Padding="6,4" MinWidth="0" MinHeight="0"
                        Background="Transparent" BorderThickness="0"/>
            </Grid>

            <!-- RPM Display (large, bold) -->
            <TextBlock x:Name="FanSpeedText"
                       Text="0 RPM (0%)"
                       FontSize="22" FontWeight="Bold"
                       Foreground="{ThemeResource TextFillColorPrimaryBrush}"/>

            <!-- Fan Speed Slider (step=4% matching firmware ENCODER_STEP) -->
            <Slider x:Name="FanSlider"
                    Minimum="0" Maximum="100"
                    StepFrequency="4"
                    SnapsTo="StepValues"
                    Value="0"
                    ValueChanged="FanSlider_ValueChanged"
                    Margin="0,6,0,0"/>

            <!-- RPM preset buttons (200 RPM steps, Tag = PWM%) -->
            <StackPanel Orientation="Horizontal" Spacing="3" Margin="0,6,0,0"
                        HorizontalAlignment="Center">
                <Button Content="Tắt" Click="PresetRpm_Click" Tag="0"
                        Padding="7,3" FontSize="10" MinWidth="0" MinHeight="0"/>
                <Button Content="600" Click="PresetRpm_Click" Tag="20"
                        Padding="7,3" FontSize="10" MinWidth="0" MinHeight="0"/>
                <Button Content="800" Click="PresetRpm_Click" Tag="28"
                        Padding="7,3" FontSize="10" MinWidth="0" MinHeight="0"/>
                <Button Content="1000" Click="PresetRpm_Click" Tag="36"
                        Padding="7,3" FontSize="10" MinWidth="0" MinHeight="0"/>
                <Button Content="1200" Click="PresetRpm_Click" Tag="44"
                        Padding="7,3" FontSize="10" MinWidth="0" MinHeight="0"/>
                <Button Content="1400" Click="PresetRpm_Click" Tag="50"
                        Padding="7,3" FontSize="10" MinWidth="0" MinHeight="0"/>
                <Button Content="1600" Click="PresetRpm_Click" Tag="56"
                        Padding="7,3" FontSize="10" MinWidth="0" MinHeight="0"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" Spacing="3" Margin="0,2,0,0"
                        HorizontalAlignment="Center">
                <Button Content="1800" Click="PresetRpm_Click" Tag="64"
                        Padding="7,3" FontSize="10" MinWidth="0" MinHeight="0"/>
                <Button Content="2000" Click="PresetRpm_Click" Tag="72"
                        Padding="7,3" FontSize="10" MinWidth="0" MinHeight="0"/>
                <Button Content="2200" Click="PresetRpm_Click" Tag="80"
                        Padding="7,3" FontSize="10" MinWidth="0" MinHeight="0"/>
                <Button Content="2400" Click="PresetRpm_Click" Tag="84"
                        Padding="7,3" FontSize="10" MinWidth="0" MinHeight="0"/>
                <Button Content="2600" Click="PresetRpm_Click" Tag="92"
                        Padding="7,3" FontSize="10" MinWidth="0" MinHeight="0"/>
                <Button Content="2800" Click="PresetRpm_Click" Tag="100"
                        Padding="7,3" FontSize="10" MinWidth="0" MinHeight="0"/>
            </StackPanel>

            <!-- Bottom bar: connection status + action buttons -->
            <Grid Margin="0,6,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock x:Name="StatusText"
                           Text="ONLINE"
                           FontSize="11"
                           VerticalAlignment="Center"
                           Foreground="LimeGreen"/>

                <Button Grid.Column="1" Content="Mở app"
                        Click="OpenApp_Click"
                        Padding="10,4" FontSize="11"
                        Margin="0,0,6,0"/>
                <Button Grid.Column="2" Content="Thoát"
                        Click="Exit_Click"
                        Padding="10,4" FontSize="11"/>
            </Grid>
        </StackPanel>
    </Grid>
</Window>
