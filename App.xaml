<Application
    x:Class="SmartFanCooling.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:converters="using:SmartFanCooling.Converters">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
            </ResourceDictionary.MergedDictionaries>

            <!-- Custom Value Converters -->
            <converters:ConnectTextConverter x:Key="ConnectTextConverter" />
            <converters:InverseBoolConverter x:Key="InverseBoolConverter" />
            <converters:StringMatchConverter x:Key="StringMatchConverter" />
            <converters:NullToBoolConverter x:Key="NullToBoolConverter" />
            <converters:FloatFormatConverter x:Key="FloatFormatConverter" />
            <converters:IntToVisibilityConverter x:Key="IntToVisibilityConverter" />
            <converters:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter" />
        </ResourceDictionary>
    </Application.Resources>
</Application>
