<Window
    x:Class="SmartFanCooling.OsdOverlayWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="SmartFanCooling OSD Overlay">

    <Grid x:Name="RootGrid" Background="Transparent" HorizontalAlignment="Left" VerticalAlignment="Top">
        <!-- SINGLE UNIFIED BACKGROUND BAR CONTAINER (Controlled by Opacity Slider) -->
        <Border x:Name="OverlayContainer"
                Background="#D90E121A"
                CornerRadius="0"
                BorderThickness="0"
                Padding="3,1"
                HorizontalAlignment="Left"
                VerticalAlignment="Top">
            <StackPanel x:Name="MetricsPanel" Orientation="Horizontal" Spacing="28" VerticalAlignment="Center">

                <!-- FPS Section -->
                <StackPanel x:Name="FpsBadge" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center" Visibility="Visible">
                    <TextBlock Text="FPS" FontSize="12" Foreground="#A0AAB8" FontWeight="Bold" VerticalAlignment="Center"/>
                    <TextBlock x:Name="FpsText" Text="60" FontSize="12" Foreground="#00E676" FontWeight="Bold" VerticalAlignment="Center"/>
                </StackPanel>

                <!-- TIME Section -->
                <StackPanel x:Name="TimeBadge" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center" Visibility="Visible">
                    <TextBlock Text="TIME" FontSize="12" Foreground="#A0AAB8" FontWeight="Bold" VerticalAlignment="Center"/>
                    <TextBlock x:Name="TimeText" Text="16:30:00" FontSize="12" Foreground="#FFFFFF" FontWeight="Bold" VerticalAlignment="Center"/>
                </StackPanel>

                <!-- CPU Section -->
                <StackPanel x:Name="CpuBadge" Orientation="Horizontal" Spacing="12" VerticalAlignment="Center" Visibility="Visible">
                    <TextBlock Text="CPU" FontSize="12" Foreground="#A0AAB8" FontWeight="Bold" VerticalAlignment="Center"/>
                    <TextBlock x:Name="CpuUsageText" Text="18%" FontSize="12" Foreground="#00E676" FontWeight="Bold" VerticalAlignment="Center"/>
                    <TextBlock x:Name="CpuTempText" Text="45°C" FontSize="12" Foreground="#00E676" FontWeight="Bold" VerticalAlignment="Center"/>
                    <TextBlock x:Name="CpuClockText" Text="5.03GHz" FontSize="12" Foreground="#00D2FF" FontWeight="Bold" VerticalAlignment="Center"/>
                    <TextBlock x:Name="CpuPowerText" Text="42W" FontSize="12" Foreground="#00D2FF" FontWeight="Bold" VerticalAlignment="Center"/>
                    <TextBlock x:Name="CpuFanText" Text="2400 RPM" FontSize="12" Foreground="#00E5FF" FontWeight="Bold" VerticalAlignment="Center"/>
                </StackPanel>

                <!-- GPU Section -->
                <StackPanel x:Name="GpuBadge" Orientation="Horizontal" Spacing="12" VerticalAlignment="Center" Visibility="Visible">
                    <TextBlock Text="GPU" FontSize="12" Foreground="#A0AAB8" FontWeight="Bold" VerticalAlignment="Center"/>
                    <TextBlock x:Name="GpuUsageText" Text="12%" FontSize="12" Foreground="#00E676" FontWeight="Bold" VerticalAlignment="Center"/>
                    <TextBlock x:Name="GpuTempText" Text="42°C" FontSize="12" Foreground="#00E676" FontWeight="Bold" VerticalAlignment="Center"/>
                    <TextBlock x:Name="GpuClockText" Text="1410MHz" FontSize="12" Foreground="#00D2FF" FontWeight="Bold" VerticalAlignment="Center"/>
                    <TextBlock x:Name="GpuPowerText" Text="43W" FontSize="12" Foreground="#00D2FF" FontWeight="Bold" VerticalAlignment="Center"/>
                    <TextBlock x:Name="GpuVramText" Text="1.7GB" FontSize="12" Foreground="#38BDF8" FontWeight="Bold" VerticalAlignment="Center"/>
                    <TextBlock x:Name="GpuFanText" Text="3200 RPM" FontSize="12" Foreground="#00E5FF" FontWeight="Bold" VerticalAlignment="Center"/>
                </StackPanel>

                <!-- LLANO FAN Section -->
                <StackPanel x:Name="FanBadge" Orientation="Horizontal" Spacing="12" VerticalAlignment="Center" Visibility="Visible">
                    <TextBlock Text="LLANO FAN" FontSize="12" Foreground="#A0AAB8" FontWeight="Bold" VerticalAlignment="Center"/>
                    <TextBlock x:Name="FanPwmText" Text="50%" FontSize="12" Foreground="#00E5FF" FontWeight="Bold" VerticalAlignment="Center"/>
                    <TextBlock x:Name="FanRpmText" Text="1400 RPM" FontSize="12" Foreground="#00E5FF" FontWeight="Bold" VerticalAlignment="Center"/>
                </StackPanel>

                <!-- RAM Section -->
                <StackPanel x:Name="RamBadge" Orientation="Horizontal" Spacing="12" VerticalAlignment="Center" Visibility="Visible">
                    <TextBlock Text="RAM" FontSize="12" Foreground="#A0AAB8" FontWeight="Bold" VerticalAlignment="Center"/>
                    <TextBlock x:Name="RamText" Text="43%" FontSize="12" Foreground="#00E676" FontWeight="Bold" VerticalAlignment="Center"/>
                </StackPanel>

            </StackPanel>
        </Border>
    </Grid>
</Window>
